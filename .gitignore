# Swift / SPM
.build/
.swiftpm/
*.xcuserstate
xcuserdata/
DerivedData/
.artifacts/

# Task worktrees. `git worktree add .worktrees/T-0007 -b task/T-0007` puts every task's checkout
# inside the repo instead of a sibling directory nothing here references. Ignored so that ~70
# checkouts never appear as untracked files, never reach `git add -A`, and never nest: a worktree
# does not populate an ignored path, so .worktrees/ stays empty inside each worktree.
.worktrees/

# Apple package + app
apps/ios/Packages/ScenicApp/.build/
apps/ios/Packages/ScenicApp/.swiftpm/

# Node
node_modules/
.wrangler/

