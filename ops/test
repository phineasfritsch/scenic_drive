#!/usr/bin/env bash
# ONE COMMAND. PRINTS A COUNT. ENFORCES A FLOOR.
#
#   ops/test              run every tier that exists on this host
#   SKIP_IOS=1 ops/test   skip the simulator tier even on macOS
#
# Prints:  TESTS linux=<total>/<floor> ios=<total>/<floor> failed=<n> skipped=<n>
# Exit 1 on any failing test, any tier below its floor, or any expected report file missing.
# A missing report never counts as zero: that is how agents make a suite "green" by breaking the reporter.
#
# Floors live in pins/floor_linux.txt and pins/floor_ios.txt. They are ratcheted UP by a reviewer only;
# .githooks/commit-msg refuses to lower one without a `floor-lower: <reason>` line in the commit body.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
PY="${PYTHON:-$(command -v python3 || command -v python)}"
ART=".artifacts"; mkdir -p "$ART"
rm -f "$ART"/spm-junit*.xml "$ART"/vitest.json "$ART"/pytest-junit.xml
linux_total=0; linux_failed=0; linux_skipped=0; ios_total=0; ios_failed=0; ios_skipped=0
junit_reports=()   # every JUnit file produced, so a red run can NAME the tests that broke
rc=0

# ---- Tier 1a: root Swift package (Linux-safe) ----------------------------------------------------
swift test --parallel --xunit-output "$ART/spm-junit.xml" 2>&1 | tee "$ART/swift-test.log" | grep -E '^(√|✘|◇|◊|Test Suite|Executed|error:|warning: unable)' | tail -8
# swift test writes XCTest results to spm-junit.xml and Swift Testing results to spm-junit-swift-testing.xml.
spm_files=()
[[ -f "$ART/spm-junit.xml" ]] && spm_files+=("$ART/spm-junit.xml")
[[ -f "$ART/spm-junit-swift-testing.xml" ]] && spm_files+=("$ART/spm-junit-swift-testing.xml")
if [[ ${#spm_files[@]} -eq 0 ]]; then echo "FAIL: swift test produced no JUnit report (expected $ART/spm-junit*.xml)"; exit 1; fi
junit_reports+=("${spm_files[@]}")
read -r t f s < <("$PY" ops/lib/junit_count.py "${spm_files[@]}" | tr -d '\r' | sed -E 's/total=([0-9]+) failed=([0-9]+) skipped=([0-9]+)/\1 \2 \3/') || { echo "FAIL: could not parse swift JUnit"; exit 1; }
linux_total=$((linux_total + t)); linux_failed=$((linux_failed + f)); linux_skipped=$((linux_skipped + s))

# ---- Tier 1b: Worker (vitest) — expected iff services/api/package.json exists --------------------
if [[ -f services/api/package.json ]]; then
  # Two unrelated failures used to print the same line. "produced no report" is written for the case this
  # runner exists to catch: vitest RAN and its reporter wrote nothing, which is what a reporter broken to
  # make the suite green looks like. An absent `npm ci` produces an identical symptom and is not that at all
  # - it is one command away, and it is what every fresh worktree hits, because CI never does (the workflow
  # runs `npm ci` first). agent/reviewer-16 spent the time to rule it out as a regression on a clean main,
  # and it has been hit again since. Separate the two, and say what to do rather than what was observed.
  if [[ ! -d services/api/node_modules ]]; then
    echo "FAIL: services/api/node_modules is absent - the Worker's dependencies were never installed here."
    echo "      Run: (cd services/api && npm ci)"
    exit 1
  fi
  # An incomplete install is its own case, and silence here is worse than a missing directory: `npx` would
  # DOWNLOAD vitest from the registry and run that instead - an unpinned version, and a suite whose result
  # depends on the network. Checking for the binary keeps the run hermetic and names the same one-line fix.
  if [[ ! -f services/api/node_modules/.bin/vitest && ! -f services/api/node_modules/.bin/vitest.cmd ]]; then
    echo "FAIL: services/api/node_modules exists but vitest is not in it - the install is incomplete."
    echo "      Run: (cd services/api && npm ci)"
    exit 1
  fi
  (cd services/api && npx vitest run --reporter=json --outputFile="../../$ART/vitest.json" >/dev/null 2>&1); true
  [[ -f "$ART/vitest.json" ]] || { echo "FAIL: services/api exists but vitest produced no report"; exit 1; }
  read -r t f s < <("$PY" - "$ART/vitest.json" <<'PYEOF' | tr -d '\r'
import json,sys; d=json.load(open(sys.argv[1])); print(d.get("numTotalTests",0), d.get("numFailedTests",0), d.get("numPendingTests",0))
PYEOF
)
  linux_total=$((linux_total + t)); linux_failed=$((linux_failed + f)); linux_skipped=$((linux_skipped + s))
fi

# ---- Tier 1c: ETL (pytest) — expected iff services/etl/pyproject.toml exists ---------------------
if [[ -f services/etl/pyproject.toml ]]; then
  # $PY is not necessarily the interpreter that HAS pytest. On the Windows dev box `command -v python3`
  # resolves to the App Execution Alias stub (a bare 3.14 with no site-packages) while `python` is the real
  # install; on Linux CI python3 is correct. Pick the first candidate that can actually import pytest, and
  # fail loudly naming what was tried rather than skipping the tier.
  etl_py=""
  for cand in "${PYTHON:-}" python3 python py; do
    [[ -z "$cand" ]] && continue
    command -v "$cand" >/dev/null 2>&1 || continue
    "$cand" -c "import pytest" >/dev/null 2>&1 && { etl_py="$cand"; break; }
  done
  [[ -n "$etl_py" ]] || { echo "FAIL: services/etl exists but no interpreter has pytest (tried: \$PYTHON python3 python py). Install it: python -m pip install pytest"; exit 1; }
  (cd services/etl && "$etl_py" -m pytest -q --junitxml="../../$ART/pytest-junit.xml" >/dev/null 2>&1); true
  [[ -f "$ART/pytest-junit.xml" ]] || { echo "FAIL: services/etl exists but pytest ($etl_py) produced no report"; exit 1; }
  junit_reports+=("$ART/pytest-junit.xml")
  read -r t f s < <("$PY" ops/lib/junit_count.py "$ART/pytest-junit.xml" | tr -d '\r' | sed -E 's/total=([0-9]+) failed=([0-9]+) skipped=([0-9]+)/\1 \2 \3/') || { echo "FAIL: could not parse pytest JUnit"; exit 1; }
  linux_total=$((linux_total + t)); linux_failed=$((linux_failed + f)); linux_skipped=$((linux_skipped + s))
fi

# ---- Tier 2: iOS simulator — macOS only, expected iff the xcodeproj exists ----------------------
ios_ran=0
if [[ "$(uname)" == "Darwin" && "${SKIP_IOS:-0}" != "1" && -d apps/ios/ScenicDrive.xcodeproj ]]; then
  ios_ran=1
  rm -rf "$ART/ScenicDrive.xcresult"
  xcodebuild test \
    -project apps/ios/ScenicDrive.xcodeproj -scheme ScenicDrive \
    -destination "${IOS_DESTINATION:-platform=iOS Simulator,name=iPhone 17}" \
    -derivedDataPath "$ART/dd" -resultBundlePath "$ART/ScenicDrive.xcresult" \
    -parallel-testing-enabled YES 2>&1 | tee "$ART/xcodebuild.log" | tail -5
  [[ -d "$ART/ScenicDrive.xcresult" ]] || { echo "FAIL: xcodebuild produced no xcresult"; exit 1; }
  summary="$(xcrun xcresulttool get test-results summary --path "$ART/ScenicDrive.xcresult" --format json --compact)"
  read -r ios_total ios_failed ios_skipped < <("$PY" - "$summary" <<'PYEOF'
import json,sys; d=json.loads(sys.argv[1]); print(d.get("totalTestCount",0), d.get("failedTests",0), d.get("skippedTests",0))
PYEOF
)
fi

# ---- Floors --------------------------------------------------------------------------------------
floor_linux="$(tr -d '[:space:]' < pins/floor_linux.txt)"
floor_ios="$(tr -d '[:space:]' < pins/floor_ios.txt)"
failed=$((linux_failed + ios_failed)); skipped=$((linux_skipped + ios_skipped))
if [[ $ios_ran -eq 1 ]]; then ios_str="$ios_total/$floor_ios"; else ios_str="skipped"; fi
echo "TESTS linux=$linux_total/$floor_linux ios=$ios_str failed=$failed skipped=$skipped"
if [[ $failed -gt 0 ]]; then
  # NAME them. Every tier's output goes to /dev/null so the count stays readable, which meant a red CI run
  # printed `failed=3` and nothing else - and the .artifacts upload that would have said which was silently
  # dropped too. Diagnosing three failures then cost a full round of re-running each tier by hand.
  echo "FAIL: $failed failing test(s):"
  [[ ${#junit_reports[@]} -gt 0 ]] && "$PY" ops/lib/junit_count.py --list-failures "${junit_reports[@]}" | sed "s/^/  - /"
  if [[ -f "$ART/vitest.json" ]]; then
    "$PY" - "$ART/vitest.json" <<'VITEOF' | sed "s/^/  - /"
import json, sys
d = json.load(open(sys.argv[1]))
for r in d.get("testResults", []):
    for a in r.get("assertionResults", []):
        if a.get("status") == "failed":
            m = (a.get("failureMessages") or [""])[0].splitlines()
            print((a.get("fullName") or a.get("title") or "?") + (f" - {m[0][:160]}" if m else ""))
VITEOF
  fi
  rc=1
fi
[[ $linux_total -lt $floor_linux ]] && { echo "FAIL: linux test count $linux_total is below floor $floor_linux - tests were deleted or a reporter broke"; rc=1; }
[[ $ios_ran -eq 1 && $ios_total -lt $floor_ios ]] && { echo "FAIL: ios test count $ios_total is below floor $floor_ios"; rc=1; }
[[ $rc -eq 0 ]] && echo "OK"
exit $rc
