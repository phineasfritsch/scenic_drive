#!/usr/bin/env bash
# Prints the toolchain state and exits non-zero if THIS checkout is misconfigured for agent work.
# Run first thing in every session: a wrong-toolchain agent is caught before a confident wrong diagnosis.
# The exit code covers only what this session can fix - toolchain, core.hooksPath, autocrlf, CRLF in tracked
# files, .gitattributes. The fleet-wide worktree sweep below prints and does not vote; `ops/sane` gates it.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
fail=0
say() { printf '%-12s %s\n' "$1" "$2"; }
CR=$(printf '\r')

say "head"     "$(git rev-parse --short HEAD 2>/dev/null || echo 'no commits yet')"
say "branch"   "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '-')"
say "swift"    "$(swift --version 2>&1 | head -1)"
say "node"     "$(node --version 2>/dev/null || echo MISSING)"
say "python"   "$(python3 --version 2>/dev/null || python --version 2>/dev/null || echo MISSING)"
say "docker"   "$(docker --version 2>/dev/null || echo 'MISSING on host (use WSL2)')"

# The worktrees, at session start, because that is the only moment somebody can still act on it. CLAUDE.md
# says to run this command first thing; a stranded branch found now is a push, found later it is 662 lines
# nobody knew existed.
#
# REPORTED, NEVER FAILED ON, and that is the whole point. This command answers "is THIS checkout and this
# toolchain configured for agent work" - every other line here is about the session's own environment and is
# something the session can fix. The fleet is not: it is 78 other directories owned by other agents, several
# of them deliberate probes nobody intends to push. A first revision let this set the exit code, and within
# one review it had eaten the exit code of the check on the line below - preflight returned 1 for BOTH the
# hazardous absolute core.hooksPath and the benign one, so the code no longer distinguished them and only
# the printed text did. `.github/workflows/linux-core.yml` runs this as a hard gate, and it passed there only
# because GitHub's checkout is a single detached-HEAD worktree with nothing to scan.
#
# The gate for this is `ops/sane` (exit 10), which runs the FULL four-state pass. Here it is `--fast`:
# on-disk, on-origin, on-the-right-branch, no per-worktree git call. Measured on this box under four
# concurrent agents, at 79 worktrees: --fast 43s, full 1m42s. Unloaded the same two were ~2s and ~12s.
if [[ -f ops/lib/check-worktrees ]]; then
  wt_out="$(bash ops/lib/check-worktrees --fast 2>&1)"; wt_rc=$?
  wt_sum=""; while IFS= read -r wl; do [[ "$wl" == WORKTREES-SUMMARY\ * ]] && wt_sum="${wl#WORKTREES-SUMMARY }"; done <<< "$wt_out"
  declare -A W=(); for kv in $wt_sum; do W["${kv%%=*}"]="${kv#*=}"; done
  if [[ $wt_rc -eq 0 ]]; then
    say "worktrees" "${W[inspected]:-?} inspected (--fast), every branch is on origin and on the right branch"
  elif [[ -z "$wt_sum" ]]; then
    say "worktrees" "check-worktrees exited $wt_rc with no WORKTREES-SUMMARY line (FYI - does not fail preflight)"
    printf '%s\n' "$wt_out" | sed 's/^/             /'
  else
    say "worktrees" "FYI ${W[problems]:-?} of ${W[inspected]:-?} need attention (does not fail preflight; ops/sane exit 10 is the gate)"
    printf '%s\n' "$wt_out" | sed 's/^/             /'
  fi
fi

# hooksPath: THREE states, and the old check collapsed them into a string comparison against ".githooks".
# An absolute value failed that test, so this printed "NOT SET" for a repository where it IS set - in every
# worktree, in every session, on the command CLAUDE.md says to run first. A check that always fails is a
# check nobody reads.
#
# The state underneath the wrong message is the one worth reporting: git resolves a RELATIVE core.hooksPath
# against the top level of the working tree, so `.githooks` is per-worktree, while an absolute path is not.
# With an absolute value pointing at the main checkout, every worktree runs MAIN's hooks - a branch cannot
# exercise its own `.githooks` change by committing, and a hook red/green demo done in a worktree tested
# main's copy. Found by the reviewer of PR #47, whose recorded REFUSED commit was in fact accepted.
hooks="$(git config --get core.hooksPath || true)"
top="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
if [[ -z "$hooks" ]]; then
  say "hooksPath" "NOT SET - run: git config core.hooksPath .githooks"; fail=1
elif [[ "$hooks" == ".githooks" ]]; then
  say "hooksPath" ".githooks (relative - resolves to THIS worktree, which is what you want)"
else
  # Resolve both sides before comparing; a value that happens to name this worktree's own directory is fine
  # however it is spelled, and only a value pointing somewhere ELSE is the hazard.
  hp="$(cd "$hooks" 2>/dev/null && pwd -P || echo "$hooks")"
  mine="$(cd "$top/.githooks" 2>/dev/null && pwd -P || echo "$top/.githooks")"
  if [[ "$hp" == "$mine" ]]; then
    say "hooksPath" "$hooks (absolute, but it is this worktree's own .githooks)"
  else
    say "hooksPath" "$hooks"
    say ""          "  ^ ABSOLUTE and NOT this worktree: hooks run from there, not from $top/.githooks."
    say ""          "    A change to .githooks on this branch is NOT what runs, and a hook red/green demo"
    say ""          "    here tests that other copy. Fix: git config core.hooksPath .githooks   (relative,"
    say ""          "    which git resolves per worktree)."
    fail=1
  fi
fi

crlf="$(git config --get core.autocrlf || echo false)"
if [[ "$crlf" == "true" ]]; then say "autocrlf" "true - run: git config core.autocrlf false"; fail=1; else say "autocrlf" "$crlf"; fi

bad="$(git ls-files -z 2>/dev/null | xargs -0 grep -lI "$CR" -- 2>/dev/null | head -3 | tr '\n' ' ')"
if [[ -n "$bad" ]]; then say "crlf-files" "FOUND: $bad"; fail=1; else say "crlf-files" "none"; fi

if grep -qE "^\* text=auto eol=lf" .gitattributes 2>/dev/null; then say "gitattrs" "eol=lf"; else say "gitattrs" "MISSING eol=lf - .gitattributes was clobbered"; fail=1; fi

if [[ -f Package.resolved ]]; then say "resolved" "$(sha256sum Package.resolved | cut -c1-12)"; else say "resolved" "none yet"; fi
say "queue"    "$(ls queue/claimed 2>/dev/null | wc -l | tr -d ' ') claimed, $(ls queue/ready 2>/dev/null | wc -l | tr -d ' ') ready"

if [[ $fail -eq 0 ]]; then echo "PREFLIGHT OK"; else echo "PREFLIGHT FAIL"; exit 1; fi
