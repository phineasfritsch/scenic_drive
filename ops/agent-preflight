#!/usr/bin/env bash
# Prints the toolchain state and exits non-zero if the repo is misconfigured for agent work.
# Run first thing in every session: a wrong-toolchain agent is caught in 5 seconds, not after a confident wrong diagnosis.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
fail=0
say() { printf '%-12s %s\n' "$1" "$2"; }
CR=$(printf '\r')

say "head"     "$(git rev-parse --short HEAD 2>/dev/null || echo 'no commits yet')"
say "branch"   "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '-')"
say "swift"    "$(swift --version 2>&1 | head -1)"
say "node"     "$(node --version 2>/dev/null || echo MISSING)"
say "python"   "$(python3 --version 2>/dev/null || python --version 2>/dev/null || echo MISSING)"
say "docker"   "$(docker --version 2>/dev/null || echo 'MISSING on host (use WSL2)')"

# hooksPath, from ops/lib/hookspath-state so that this and ops/sane cannot drift apart or disagree. The
# check it replaced was a string comparison against ".githooks", which printed "NOT SET" for a repository
# where the value IS set - just set to an absolute path - and so said the wrong thing in every worktree for
# the whole of the day the value was actually wrong.
#
# The exit status is consumed; the output is not grepped. A missing library FAILS: preflight's job is to
# refuse a session that cannot be trusted, and an unrun hooks check has not cleared the hooks.
if [[ ! -f ops/lib/hookspath-state ]]; then
  say "hooksPath" "ops/lib/hookspath-state is MISSING - the hooks check could not run"; fail=1
else
  hp_out="$(bash ops/lib/hookspath-state 2>&1)"; hp_rc=$?
  if [[ $hp_rc -eq 0 ]]; then
    say "hooksPath" "$(printf '%s\n' "$hp_out" | head -1 | sed 's/^HOOKSPATH ok  *//')"
  else
    say "hooksPath" "$(printf '%s\n' "$hp_out" | head -1 | sed 's/^HOOKSPATH //')"
    printf '%s\n' "$hp_out" | tail -n +2 | sed 's/^/             /'
    fail=1
  fi
fi

crlf="$(git config --get core.autocrlf || echo false)"
if [[ "$crlf" == "true" ]]; then say "autocrlf" "true - run: git config core.autocrlf false"; fail=1; else say "autocrlf" "$crlf"; fi

bad="$(git ls-files -z 2>/dev/null | xargs -0 grep -lI "$CR" -- 2>/dev/null | head -3 | tr '\n' ' ')"
if [[ -n "$bad" ]]; then say "crlf-files" "FOUND: $bad"; fail=1; else say "crlf-files" "none"; fi

if grep -qE "^\* text=auto eol=lf" .gitattributes 2>/dev/null; then say "gitattrs" "eol=lf"; else say "gitattrs" "MISSING eol=lf - .gitattributes was clobbered"; fail=1; fi

if [[ -f Package.resolved ]]; then say "resolved" "$(sha256sum Package.resolved | cut -c1-12)"; else say "resolved" "none yet"; fi
say "queue"    "$(ls queue/claimed 2>/dev/null | wc -l | tr -d ' ') claimed, $(ls queue/ready 2>/dev/null | wc -l | tr -d ' ') ready"

if [[ $fail -eq 0 ]]; then echo "PREFLIGHT OK"; else echo "PREFLIGHT FAIL"; exit 1; fi
