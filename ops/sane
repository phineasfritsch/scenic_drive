#!/usr/bin/env bash
# IS THE STATE SANE. One command, one line per check, distinct exit codes, never mutates anything.
#
#   ops/sane            repo-only checks (2)
#   ops/sane --prod     + deployed version vs this checkout (3), backend health (7), legal URLs (9)
#
# Exit codes (the FIRST failing check in this order decides; all checks still run and print):
#   2  repo not sane: untracked .swift inside a buildable/package folder, CRLF in tracked files, autocrlf=true,
#      .gitattributes without eol=lf
#   7  backend down: /__health unreachable or not ok, or no API URL to ask
#   3  deployed Worker != this checkout: live git_sha is not in HEAD's history, or services/api changed since it
#      (only reachable when 7 passed - the version check runs inside the "backend is up" branch)
#   9  legal URLs (Terms, Privacy) not returning 200
#   4  region extract out of bounds: a built work/<region>/meta.json disagrees with the counts recorded
#      in regions/<region>/region.json by more than the tolerance, or cannot be read at all (T-0024)
#  10  another worktree holds work that is not on origin - invisible to every other check here
#   5/6/8 reserved: golden routes, quota/kill switch, R2 manifests - added with T-0008/T-0014.
#
# That list is a comment, and a comment cannot be enforced. EXIT_ORDER below says the same thing as DATA, and
# ops/lib/check-sane-exit-order (pin P-OPS-05) refuses when it disagrees with the order the fail() calls in
# this file actually run in - which is the real precedence, because fail() keeps the FIRST code it is given.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
PY="${PYTHON:-$(command -v python3 || command -v python)}"
CR=$(printf '\r')
prod=0; [[ "${1:-}" == "--prod" ]] && prod=1
rc=0
# The documented precedence, as data. Read by ops/lib/check-sane-exit-order, which compares it against the
# order the fail() calls below appear in. Reorder a check block and this array must move with it.
EXIT_ORDER=(2 7 3 9 4 10)
say()  { printf '%-9s %-6s %s\n' "$1" "$2" "$3"; }
fail() { say "$1" "FAIL" "$2"; [[ $rc -eq 0 ]] && rc=$3; }
ok()   { say "$1" "ok" "$2"; }
skip() { say "$1" "skip" "$2"; }

# ---- 2. repo ----------------------------------------------------------------------------------------
stray="$(git status --porcelain --untracked-files=all -- Sources Tests apps/ios 2>/dev/null | grep -E '^\?\? .*\.swift$' | head -3 | tr '\n' ' ')"
if [[ -n "$stray" ]]; then fail "repo" "untracked .swift is IN the build (buildable folders): $stray" 2; else ok "repo" "no stray .swift"; fi
crlf="$(git ls-files -z | xargs -0 grep -lI "$CR" -- 2>/dev/null | head -3 | tr '\n' ' ')"
if [[ -n "$crlf" ]]; then fail "crlf" "tracked files with CRLF: $crlf" 2; else ok "crlf" "none"; fi
if [[ "$(git config --get core.autocrlf || echo false)" == "true" ]]; then fail "autocrlf" "true" 2; else ok "autocrlf" "$(git config --get core.autocrlf || echo unset)"; fi
if grep -qE '^\* text=auto eol=lf' .gitattributes 2>/dev/null; then ok "gitattrs" "eol=lf"; else fail "gitattrs" "missing eol=lf" 2; fi

# ---- 3 / 7 / 9. production --------------------------------------------------------------------------
if [[ $prod -eq 1 ]]; then
  url="${API_URL:-$(cat ops/api-url 2>/dev/null || true)}"
  if [[ -z "$url" ]]; then
    fail "backend" "no API URL (ops/api-url missing)" 7
  else
    health="$(curl -fsS --max-time 10 -A scenic-ops-sane/1 "$url/__health" 2>/dev/null || true)"
    if [[ -z "$health" ]] || ! printf '%s' "$health" | grep '"ok":true' >/dev/null; then
      fail "backend" "$url/__health -> ${health:-unreachable}" 7
    else
      ok "backend" "$url up, db up"
      live="$(curl -fsS --max-time 10 -A scenic-ops-sane/1 "$url/__version" 2>/dev/null | "$PY" -c 'import json,sys; print(json.load(sys.stdin).get("git_sha",""))' 2>/dev/null || true)"
      head="$(git rev-parse HEAD)"
      if [[ -z "$live" || "$live" == "dev" ]]; then
        fail "version" "live git_sha is '${live:-empty}' (not a real deploy)" 3
      elif ! git cat-file -e "$live^{commit}" 2>/dev/null; then
        fail "version" "live $live is not a commit this checkout knows (fetch, or a foreign deploy)" 3
      elif ! git merge-base --is-ancestor "$live" "$head"; then
        fail "version" "live $(git rev-parse --short "$live") is not in HEAD's history (deployed from an unmerged branch?)" 3
      elif ! git diff --quiet "$live" "$head" -- services/api ops/deploy; then
        fail "version" "services/api changed since live $(git rev-parse --short "$live") -> deploy pending: $(git diff --name-only "$live" "$head" -- services/api ops/deploy | head -3 | tr '\n' ' ')" 3
      else
        ok "version" "live $(git rev-parse --short "$live") == Worker code at HEAD $(git rev-parse --short "$head")"
      fi
    fi
  fi
  if [[ -f ops/legal-urls ]]; then
    while IFS= read -r u; do
      [[ -z "$u" || "$u" == \#* ]] && continue
      code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 -A scenic-ops-sane/1 "$u" || echo 000)"
      if [[ "$code" == "200" ]]; then ok "legal" "$u"; else fail "legal" "$u -> $code" 9; fi
    done < ops/legal-urls
  else
    skip "legal" "no ops/legal-urls yet (Terms + Privacy pages land with M6)"
  fi
  skip "corpus" "T-0008 (graph hash, counts, gate parity)"
  skip "goldens" "T-0008 (live routing goldens)"
  skip "quota" "T-0014 (kill switch, projected calls)"
fi

# ---- 4. region extract bounds -----------------------------------------------------------------------
# Reads what a build already produced; never builds, never mutates. Skips when nothing has been built here,
# because ops/sane runs on machines that have never seen a 1.3 GB PBF - but a build that EXISTS and disagrees
# with its recorded counts is a failure, not a skip. A meta.json that cannot be read or carries no counts is
# also 4 (checkbounds rc=2): "cannot tell" is never ok.
#
# BELOW the production section, deliberately, for the same reason check 10 sits below it: the header says
# "the FIRST failing check in this order decides" over a list ending 9, 4, 10, and fail() keeps the first code
# it is given, so precedence IS execution order. This block shipped ABOVE the production section in T-0024 and
# a dead backend plus one out-of-band extract exited 4 where the table said 7 - the same defect check 10 had
# already been moved down here to fix. EXIT_ORDER at the top of this file and ops/lib/check-sane-exit-order
# (P-OPS-05) now make that disagreement a failing check rather than something a reader has to notice.
if [[ -d services/etl/etl ]]; then
  bounds="$(cd services/etl && "$PY" -m etl.checkbounds 2>&1)"; brc=$?
  first="$(printf '%s\n' "$bounds" | head -1)"
  rest="$(printf '%s\n' "$bounds" | tail -n +2 | head -3 | tr '\n' ' ')"
  case $brc in
    0) if printf '%s' "$first" | grep 'skip' >/dev/null; then skip "bounds" "no extract built here"; \
       else ok "bounds" "${first#BOUNDS ok    }"; fi;;
    4) fail "bounds" "region counts out of band: $rest" 4;;
    *) fail "bounds" "cannot check region counts: $first $rest" 4;;
  esac
else
  skip "bounds" "no services/etl"
fi

# ---- 10. other worktrees ------------------------------------------------------------------------------
# Every check above this line asks about THIS checkout. There are 78 others, and work that never left one of
# them is invisible to all of them: `wt/T-0030` held 662 lines of the corpus emitter with no
# `origin/task/T-0030` at all, and only a hand sweep found it. This runs the FULL four-state pass (untracked
# inside the task's touches:, modified, unpushed, wrong branch) - the cheap subset alone caught T-0030 only
# because its branch was missing too, so pushing the branch and leaving the files would have gone green.
#
# LAST, deliberately: the header above says "the FIRST failing check in this order decides" over a list
# ending 7, 9, 10, and `fail` keeps the first code it is given. When this block sat above the production
# section, a dead backend plus one stranded worktree exited 10 instead of 7 - the code contradicted the
# table three lines above it.
if [[ -f ops/lib/check-worktrees ]]; then
  wt_out="$(bash ops/lib/check-worktrees 2>&1)"; wt_rc=$?
  # Read the counts the check EMITS. The previous version derived them with `grep -c '^  '` over this
  # output, which also matched the continuation lines of the check's own summary, and printed "6
  # worktree(s)" two lines above the check's own "3 of 75". A gate that scrapes the prose of the thing it
  # reports on is inventing its number.
  wt_sum=""; while IFS= read -r wl; do [[ "$wl" == WORKTREES-SUMMARY\ * ]] && wt_sum="${wl#WORKTREES-SUMMARY }"; done <<< "$wt_out"
  if [[ -z "$wt_sum" ]]; then
    fail "worktrees" "check-worktrees exited $wt_rc with no WORKTREES-SUMMARY line - refusing to invent a count" 10
    printf '%s\n' "$wt_out" | sed 's/^/          /'
  else
    declare -A W=(); for kv in $wt_sum; do W["${kv%%=*}"]="${kv#*=}"; done
    if [[ $wt_rc -eq 0 ]]; then
      ok "worktrees" "${W[inspected]} inspected, ${W[statted]} statted, ${W[touches]} with touches: - clean (mode=${W[mode]})"
    else
      fail "worktrees" "${W[problems]:-?} of ${W[inspected]:-?} need attention - untracked:${W[untracked]:-?} modified:${W[modified]:-?} unpushed:${W[unpushed]:-?} wrong-branch:${W[branch]:-?} missing:${W[missing]:-?}" 10
      printf '%s\n' "$wt_out" | sed 's/^/          /'
    fi
  fi
else
  skip "worktrees" "ops/lib/check-worktrees not present"
fi

if [[ $rc -eq 0 ]]; then echo "SANE OK"; else echo "SANE FAIL exit=$rc"; fi
exit $rc
