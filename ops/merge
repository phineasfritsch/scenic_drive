#!/usr/bin/env bash
# MERGE A PR ONLY IF ITS CHECKS ARE ACTUALLY GREEN.
#
#   ops/merge 9              merge PR 9 if every check succeeded and the queue task is in done/
#   ops/merge 9 --wait       poll until checks finish (up to ~20 min), then merge or refuse
#   ops/merge 9 --dry-run    run every gate and report the verdict; never merges
#   ops/merge 9 --no-task-reason="why"   PR 9's branch names no T-nnnn task (queue-only branch, revert, hotfix) -
#                                        override the queue/done/ review gate, on the record, with a reason
#
# A branch whose name has no T-nnnn task id gets NO free pass: gate 1 refuses by default. Waiting must not become
# merging, and convenient must not be the same as unchecked - so the only way past it is the reasoned override
# above, which prints the reason before continuing. See queue/done/T-0022-*.md for the argument.
#
# Why this exists: on 2026-09-07 main was broken by merging a PR while `gh` reported mergeStateStatus=UNSTABLE.
# GitHub-side branch protection would prevent that, but it is 403 on a private repo on the free plan
# ("Upgrade to GitHub Pro or make this repository public"), so the gate lives here instead.
#
# HONEST LIMITATION: this is a client-side gate. Nothing stops someone typing `gh pr merge` directly. It makes the
# safe path the easy path; it does not make the unsafe path impossible. For that, buy GitHub Pro (~$4/mo) and
# enable branch protection requiring the linux-core checks, or make the repo public.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
PY="${PYTHON:-$(command -v python3 || command -v python)}"
# Checked here rather than at first use: without it an absent python surfaces as `"" -c: command not found`
# midway through a gate, which reads like a gate failure rather than a missing dependency.
[[ -n "$PY" ]] || { echo "ops/merge: no python3/python on PATH (set PYTHON=...)"; exit 2; }

pr="${1:-}"
[[ -n "$pr" ]] || { echo "usage: ops/merge <pr-number> [--wait] [--dry-run] [--no-task-reason=<reason>]"; exit 2; }
wait=0; dry=0; no_task_reason=""
for arg in "${@:2}"; do
  case "$arg" in
    --wait) wait=1;;
    --dry-run) dry=1;;
    --no-task-reason=*) no_task_reason="${arg#--no-task-reason=}";;
    *) echo "unknown option: $arg"; exit 2;;
  esac
done
# The override reason is operator-supplied text that ops/merge echoes into its own output, i.e. into the audit
# trail. It must never be able to (a) fabricate a line shaped like one of ops/merge's own gate lines, (b) repaint
# or otherwise control the terminal, or (c) be long enough to scroll real gate output out of view. So, in order:
#   1. CR/LF/tab collapse to a single space (this is what actually closes the injection: a reason can no longer
#      contain a line break, so it can never start a new line - and every gate line below is only ever emitted
#      as its own `echo`, right after a real newline this script produced itself).
#   2. Every other ASCII control byte is deleted outright - this is what kills ANSI escapes (ESC is 0x1B, a
#      control byte) before they ever reach a terminal.
#   3. Runs of whitespace collapse to one space, then leading/trailing whitespace is trimmed. This subsumes the
#      original "whitespace-only counts as no reason, not a reason" rule; it now runs after sanitizing rather
#      than before, so a reason of pure control bytes/newlines is correctly treated as empty too.
#   4. U+0085, U+2028 and U+2029 collapse to a space as well, and step 3's collapse-and-trim is repeated over
#      the result. `tr` works on bytes, and those three are the line breaks it cannot see - but str.splitlines()
#      honours them, and so does every other Unicode-aware reader of this audit trail. Until T-0049's review a
#      reason carrying one of them still produced a SECOND line of output, shaped like a gate line, with the
#      closing <<< stranded at its tail (agent/reviewer-39 forged `MERGED pr=...` and `DRY RUN:` lines this
#      way end to end). That closes the set: splitlines() honours ten code points, and the other five - U+000B,
#      U+000C and U+001C-U+001E - are already deleted as control bytes at step 2.
#   5. The result is capped at $no_task_reason_max CHARACTERS - a giant reason is a milder version of the same
#      attack (burying real output instead of forging it) and gets the same treatment. The cap is a display
#      bound, so it counts what is displayed: 200 bytes of Japanese is 66 glyphs and 200 bytes of emoji is 50,
#      and an audit annotation must not be silently rationed by the script its author writes in.
#      This step is python and not `${#s}` / `${s:0:n}` on purpose (T-0049): bash parameter expansion does not
#      count characters here. With no locale set it counts bytes, and under LC_ALL=C.UTF-8 on the Cygwin bash
#      this repo is driven from it counts UTF-16 code units. Both cut a multi-byte character in half at the
#      boundary and put invalid UTF-8 into the audit line. Decoding with errors="replace" also means a reason
#      that arrived as invalid bytes is repaired rather than echoed: the audit line is always valid UTF-8.
#      If steps 4-5 fail, the reason comes out empty and gate 1 refuses the merge - fail-closed, as it should.
# Residual, accepted limitations: (a) non-ASCII format and space characters that are NOT line breaks survive -
# a bidi override (U+202E), or a U+00A0 that rebuilds the 5-space `task     ` column of a gate line. Neither
# matters while nothing can start a line, which is what steps 1 and 4 together guarantee; nested inside the
# >>> <<< delimiters they are operator text and read as such. (b) the cap counts code points, not grapheme
# clusters, so it can still split a ZWJ emoji sequence or strand a combining mark - the result is valid UTF-8
# that renders as a different glyph, and truncation always carries the ...[truncated] marker, so a mangled
# reason can never pose as a complete one. Full Unicode sanitizing is out of scope for a one-line annotation.
no_task_reason_max=200
no_task_reason="$(
  printf '%s' "$no_task_reason" \
    | tr '\n\r\t' '   ' \
    | tr -d '\000-\010\013\014\016-\037\177' \
    | tr -s ' ' \
    | sed -e 's/^ *//' -e 's/ *$//' \
    | "$PY" -c 'import re, sys
cap = int(sys.argv[1])
s = sys.stdin.buffer.read().decode("utf-8", "replace")
s = re.sub("[  ]", " ", s)
s = re.sub(" +", " ", s).strip(" ")
if len(s) > cap:
    s = s[:cap] + "...[truncated]"
sys.stdout.buffer.write(s.encode("utf-8"))' "$no_task_reason_max"
)"
repo="$(gh repo view --json nameWithOwner -q .nameWithOwner)"

# --- 1. the PR's queue task must be in done/, i.e. a reviewer signed it off ---------------------------
head_ref="$(gh pr view "$pr" --json headRefName -q .headRefName 2>/dev/null)"
[[ -n "$head_ref" ]] || { echo "MERGE REFUSED: PR $pr does not exist or is not readable"; exit 1; }
task="$(printf '%s' "$head_ref" | grep -oE 'T-[0-9]{4}' || true)"
if [[ -n "$task" ]]; then
  if ! gh api "repos/$repo/contents/queue/done?ref=$head_ref" --jq '.[].name' 2>/dev/null | grep -q "^$task-"; then
    echo "MERGE REFUSED: $task is not in queue/done/ on $head_ref - a reviewer has not signed it off"
    exit 1
  fi
  echo "task     $task is in queue/done/ on $head_ref"
elif [[ -n "$no_task_reason" ]]; then
  # Opt-in, per-invocation, and requires a reason: a no-task merge always leaves one on the record instead of a
  # bare flag someone could alias into a new silent default. Covers queue-only branches, reverts, hotfixes.
  # The reason is wrapped in >>> <<< so it stays visibly free-form operator text even if sanitizing above ever
  # has a gap: nothing inside the delimiters, on its own, reads as a gate line - a gate line is always a whole
  # echo of its own, never text nested inside another line's delimiters.
  echo "task     branch $head_ref names no task; review gate overridden on record: >>>$no_task_reason<<<"
else
  echo "MERGE REFUSED: branch $head_ref names no task (no T-nnnn), so the review gate can't check queue/done/ for it"
  echo "  If this is really a no-task branch (queue-only maintenance, a revert, a hotfix), rerun with"
  echo "  --no-task-reason=\"<why merging without a reviewed queue task is safe here>\" to override, on the record."
  exit 1
fi

# --- 2. every check run must have succeeded -----------------------------------------------------------
attempt=0
while :; do
  attempt=$((attempt + 1))
  state="$(gh pr view "$pr" --json mergeStateStatus -q .mergeStateStatus)"
  rollup="$(gh pr view "$pr" --json statusCheckRollup -q '[.statusCheckRollup[]? | {name: (.name // .context), c: (.conclusion // .state // "PENDING")}]')"
  pending="$("$PY" -c 'import json,sys; d=json.loads(sys.argv[1]); print(sum(1 for x in d if x["c"] in ("PENDING","IN_PROGRESS","QUEUED","")))' "$rollup")"
  failed="$("$PY" -c 'import json,sys; d=json.loads(sys.argv[1]); print(",".join(x["name"] for x in d if x["c"] in ("FAILURE","CANCELLED","TIMED_OUT","ACTION_REQUIRED","ERROR")))' "$rollup")"
  total="$("$PY" -c 'import json,sys; print(len(json.loads(sys.argv[1])))' "$rollup")"
  echo "checks   total=$total pending=$pending failed=[${failed:-none}] mergeState=$state"
  [[ -n "$failed" ]] && { echo "MERGE REFUSED: failing checks: $failed"; exit 1; }
  if [[ "$pending" -gt 0 ]]; then
    if [[ $wait -eq 1 && $attempt -lt 40 ]]; then sleep 30; continue; fi
    echo "MERGE REFUSED: $pending check(s) still running (use --wait to poll)"; exit 1
  fi
  break
done
[[ "$total" -gt 0 ]] || { echo "MERGE REFUSED: no checks reported at all - CI did not run for this PR"; exit 1; }
case "$state" in
  CLEAN|HAS_HOOKS) ;;
  *) echo "MERGE REFUSED: mergeStateStatus=$state (want CLEAN)"; exit 1;;
esac

# --- 3. merge -----------------------------------------------------------------------------------------
if [[ $dry -eq 1 ]]; then
  echo "DRY RUN: every gate passed; would merge pr=$pr task=${task:-none} head=$head_ref"
  exit 0
fi
gh pr merge "$pr" --merge --delete-branch 2>&1 | tail -2
merged="$(gh pr view "$pr" --json state -q .state)"
[[ "$merged" == "MERGED" ]] || { echo "MERGE FAILED: PR is $merged"; exit 1; }
echo "MERGED pr=$pr task=${task:-none} head=$head_ref"
