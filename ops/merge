#!/usr/bin/env bash
# MERGE A PR ONLY IF ITS CHECKS ARE ACTUALLY GREEN.
#
#   ops/merge 9              merge PR 9 if every check succeeded and the queue task is in done/
#   ops/merge 9 --wait       poll until checks finish (up to ~20 min), then merge or refuse
#   ops/merge 9 --dry-run    run every gate and report the verdict; never merges
#
# Why this exists: on 2026-09-07 main was broken by merging a PR while `gh` reported mergeStateStatus=UNSTABLE.
# GitHub-side branch protection would prevent that, but it is 403 on a private repo on the free plan
# ("Upgrade to GitHub Pro or make this repository public"), so the gate lives here instead.
#
# HONEST LIMITATION: this is a client-side gate. Nothing stops someone typing `gh pr merge` directly. It makes the
# safe path the easy path; it does not make the unsafe path impossible. For that, buy GitHub Pro (~$4/mo) and
# enable branch protection requiring the linux-core checks, or make the repo public.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
PY="${PYTHON:-$(command -v python3 || command -v python)}"

pr="${1:-}"
[[ -n "$pr" ]] || { echo "usage: ops/merge <pr-number> [--wait]"; exit 2; }
wait=0; dry=0
for arg in "${@:2}"; do
  case "$arg" in
    --wait) wait=1;;
    --dry-run) dry=1;;
    *) echo "unknown option: $arg"; exit 2;;
  esac
done
repo="$(gh repo view --json nameWithOwner -q .nameWithOwner)"

# --- 1. the PR's queue task must be in done/, i.e. a reviewer signed it off ---------------------------
head_ref="$(gh pr view "$pr" --json headRefName -q .headRefName 2>/dev/null)"
[[ -n "$head_ref" ]] || { echo "MERGE REFUSED: PR $pr does not exist or is not readable"; exit 1; }
task="$(printf '%s' "$head_ref" | grep -oE 'T-[0-9]{4}' || true)"
if [[ -n "$task" ]]; then
  if ! gh api "repos/$repo/contents/queue/done?ref=$head_ref" --jq '.[].name' 2>/dev/null | grep -q "^$task-"; then
    echo "MERGE REFUSED: $task is not in queue/done/ on $head_ref - a reviewer has not signed it off"
    exit 1
  fi
  echo "task     $task is in queue/done/ on $head_ref"
else
  echo "task     (branch $head_ref names no task; skipping the review gate)"
fi

# --- 2. every check run must have succeeded -----------------------------------------------------------
attempt=0
unknown_tries=0
while :; do
  attempt=$((attempt + 1))
  state="$(gh pr view "$pr" --json mergeStateStatus -q .mergeStateStatus)"
  rollup="$(gh pr view "$pr" --json statusCheckRollup -q '[.statusCheckRollup[]? | {name: (.name // .context), c: (.conclusion // .state // "PENDING"), t: (.completedAt // .startedAt // "")}]')"
  # The rollup holds one entry per check RUN, not per check. A PR that failed, was fixed and re-ran carries
  # BOTH, and classifying every entry refuses a PR whose CI is green. Measured on PR #26 (task/T-0024):
  # a `core` FAILURE at 01:26 and a `core` SUCCESS at 01:50, `gh pr checks 26` reporting both checks pass,
  # and this tool printing `total=4 pending=0 failed=[core]` and refusing. `total=4` in a two-check
  # repository was the tell, and it was printed on every merge this gate has ever run without being read.
  #
  # Wrong in the direction that BLOCKS, and more likely the more a branch is repaired after review - so it
  # punishes exactly the branches that did the work, and the workaround is the `gh pr merge` that
  # queue/README.md step 7 forbids. Reduce to the latest run per name before classifying anything.
  #
  # AN UNFINISHED RUN IS NOT ORDERED BY ITS TIMESTAMP, BECAUSE IT HAS NONE. A run still in flight has no
  # `completedAt`, and `gh` renders the absent value either as null - so `//` falls through to `startedAt`,
  # which a QUEUED run also lacks - or as the Go zero time "0001-01-01T00:00:00Z". Both sort BELOW every
  # real 2026 timestamp, so ordering on `t` alone keeps the OLD completed run and throws the in-flight one
  # away: `pending` is then summed over a set the running check is not in and the gate MERGES WHILE CI IS
  # RUNNING - the exact failure this file exists to prevent. So the key is (unfinished, t): an in-flight run
  # outranks every finished run of its name whatever `t` says, and `t` only breaks ties within a class.
  # Reported by reviewer-pr57 against the first version of this reduction; both serializations are replayed
  # as F2/F3 in `ops/merge-selftest`, which fails if either one merges.
  #
  # Ties inside a class (two finished runs, neither with a timestamp) keep the later entry in GitHub's own
  # order. That is a real ambiguity, not a resolved one: it is only reachable when a check reports no times.
  # `| tr -d '\r'`: python's text-mode stdout writes CRLF on Windows and `read` splits on LF, so without
  # this the LAST field carries a trailing carriage return. That is not hypothetical - it made `failed`
  # compare unequal to "-" and this tool refused a green PR with `failing checks: -`. The CR arrives WITH
  # `read`: the command substitution this replaced stripped the trailing CRLF itself, so the code replaced
  # here did not have this bug (an earlier version of this Log claimed it did; measured, it did not).
  if ! read -r n_checks n_runs pending failed < <("$PY" - "$rollup" <<'PYCHECKS' | tr -d '\r'
import json, sys
runs = json.loads(sys.argv[1])
PEND = ("PENDING", "IN_PROGRESS", "QUEUED", "")
FAIL = ("FAILURE", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "ERROR")
def rank(r):
    return (1 if r["c"] in PEND else 0, r["t"] or "")
latest = {}
for r in runs:
    prev = latest.get(r["name"])
    if prev is None or rank(r) >= rank(prev):
        latest[r["name"]] = r
cur = list(latest.values())
print(len(cur), len(runs),
      sum(1 for x in cur if x["c"] in PEND),
      ",".join(sorted(x["name"] for x in cur if x["c"] in FAIL)) or "-")
PYCHECKS
)
  then
    # Without this the classifier crashing leaves every field empty, which reaches the `total` guard below
    # and refuses with "CI did not run for this PR" - a reason that is not true. Fails closed either way;
    # this way it fails closed and says what actually happened.
    echo "MERGE REFUSED: could not classify the check rollup (no verdict line from the reducer)"; exit 1
  fi
  [[ "$failed" == "-" ]] && failed=""
  total="$n_checks"
  # Both numbers are printed on purpose: runs > checks is the state that produced this bug, and a reader
  # who can see it can diagnose a stale refusal without reading the rollup by hand.
  echo "checks   checks=$n_checks runs=$n_runs pending=$pending failed=[${failed:-none}] mergeState=$state"
  [[ -n "$failed" ]] && { echo "MERGE REFUSED: failing checks: $failed"; exit 1; }
  if [[ "$pending" -gt 0 ]]; then
    if [[ $wait -eq 1 && $attempt -lt 40 ]]; then sleep 30; continue; fi
    echo "MERGE REFUSED: $pending check(s) still running (use --wait to poll)"; exit 1
  fi
  # UNKNOWN is not a verdict. GitHub computes mergeStateStatus lazily: the first query returns UNKNOWN and
  # TRIGGERS the computation, and a second query moments later returns the real value. Refusing on it makes
  # the FIRST run against any PR nobody has touched today fail - measured on 2026-09-08, when a sweep of
  # fifteen signed-off PRs returned UNKNOWN for all fifteen and a re-query returned CLEAN for every one.
  # That is the whole backlog refused on first contact, by the command the operator has to run 41 times.
  #
  # Deliberately NOT behind --wait: --wait is for CI that is still running, and this is not waiting for
  # anything to happen - it is asking a question GitHub had not been asked yet. Bounded, so a genuinely
  # stuck field still refuses rather than spinning.
  if [[ "$state" == "UNKNOWN" && $unknown_tries -lt 3 ]]; then
    unknown_tries=$((unknown_tries + 1))
    echo "         mergeState=UNKNOWN (GitHub computes it on demand); re-asking ($unknown_tries/3)"
    sleep 3
    continue
  fi
  break
done
# `total` is now DISTINCT check names, not runs. The guard is unchanged in meaning and finally means it:
# a PR with four runs of one check is not a PR with four checks.
[[ "$total" -gt 0 ]] || { echo "MERGE REFUSED: no checks reported at all - CI did not run for this PR"; exit 1; }
case "$state" in
  CLEAN|HAS_HOOKS) ;;
  *) echo "MERGE REFUSED: mergeStateStatus=$state (want CLEAN)"; exit 1;;
esac

# --- 3. merge -----------------------------------------------------------------------------------------
if [[ $dry -eq 1 ]]; then
  echo "DRY RUN: every gate passed; would merge pr=$pr task=${task:-none} head=$head_ref"
  exit 0
fi
gh pr merge "$pr" --merge --delete-branch 2>&1 | tail -2
merged="$(gh pr view "$pr" --json state -q .state)"
[[ "$merged" == "MERGED" ]] || { echo "MERGE FAILED: PR is $merged"; exit 1; }
echo "MERGED pr=$pr task=${task:-none} head=$head_ref"
