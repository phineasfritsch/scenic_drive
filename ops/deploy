#!/usr/bin/env bash
# Deploys the Worker and PRINTS THE DEPLOYED VERSION. Refuses to run unless:
#   1. HEAD is reachable on origin (push before deploy - enforced, not remembered),
#   2. the working tree is clean for services/api (a deploy of uncommitted code has no version),
#   3. queue/LOCKS/prod.lock is held (deploys are serial; the task holding the lock is accountable).
# After deploying it re-fetches /__version from the live URL and exits non-zero if live != HEAD.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
ART=".artifacts"; mkdir -p "$ART"
sha="$(git rev-parse HEAD)"

if ! git branch -r --contains "$sha" 2>/dev/null | grep -q "origin/"; then
  echo "DEPLOY REFUSED: HEAD $sha is not on origin - push first"; exit 1
fi
if [[ -n "$(git status --porcelain -- services/api ops/deploy)" ]]; then
  echo "DEPLOY REFUSED: uncommitted changes under services/api"; exit 1
fi
if [[ ! -f queue/LOCKS/prod.lock && "${DEPLOY_UNLOCKED:-0}" != "1" ]]; then
  echo "DEPLOY REFUSED: queue/LOCKS/prod.lock not held (claim a task with exclusive: [prod])"; exit 1
fi

built_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
( cd services/api && npx wrangler deploy --var "GIT_SHA:$sha" --var "BUILT_AT:$built_at" ) 2>&1 | tee "$ART/deploy.log" | tail -4

url="$(grep -oE 'https://[a-z0-9.-]+\.workers\.dev' "$ART/deploy.log" | head -1 || true)"
if [[ -z "$url" ]]; then url="$(cat ops/api-url 2>/dev/null || true)"; fi
if [[ -z "$url" ]]; then echo "DEPLOY FAILED: no workers.dev URL in output and no ops/api-url"; exit 1; fi
printf '%s\n' "$url" > ops/api-url

sleep 2
live="$(curl -fsS --max-time 10 "$url/__version" | "${PYTHON:-python3}" -c 'import json,sys; print(json.load(sys.stdin)["git_sha"])' || echo "unreachable")"
echo "DEPLOYED sha=$sha live=$live built_at=$built_at url=$url"
if [[ "$live" != "$sha" ]]; then echo "DEPLOY MISMATCH: live version is not HEAD"; exit 1; fi
