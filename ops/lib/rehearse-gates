#!/usr/bin/env bash
# The gate set ops/merge-rehearse runs after each merge, as a SCRIPT rather than a function inside it.
#
# It is a separate file for one reason: it can be run. The reviewer who found that the function this replaces
# ignored the exit code of every check it called had to copy the function into a file to demonstrate it - and
# a copy is not the thing. Now the demonstration runs the same bytes the rehearsal runs:
#
#     cd <any worktree> && bash <this repo>/ops/lib/rehearse-gates ; echo $?
#
# CONTRACT
#   stdout   one finding per line, "<check>: <message>". Nothing at all on a clean tree.
#   exit 0   clean - every check ran and every check passed
#   exit 1   findings, listed on stdout
#   exit 3   COULD NOT MEASURE. Never a finding. The caller must abort the run, because a check that could
#            not run is not evidence of anything: not that the tree is clean, and not that it is broken.
#
# Exit 3 is the whole point of the rewrite. `ops/merge-rehearse` used to answer every question from whatever
# text a failed command happened to leave in a variable, and on 2026-09-08 that turned a deleted scratch
# worktree into 93 confident, specific, false findings. An empty result that means "I could not look" must
# never be reported as "there is nothing there" - the assertion ops/lib/check-exec-bits and
# ops/lib/check-line-cap both carry in their headers, and which this tool did not inherit until now.
#
# WHICH TREE. The cwd, always - no `cd` to a toplevel and no path relative to this file. The rehearsal runs
# THIS copy of the harness (fixed for the whole run, so every row is measured the same way) against the merged
# tree in the scratch worktree, and invokes the CHECKS out of that merged tree, because the merged tree's own
# checks running on the merged tree is the thing under test.
set -uo pipefail

# ---------------------------------------------------------------- can this tree be measured at all
git rev-parse --git-dir >/dev/null 2>&1 || {
  echo "cannot measure: $(pwd 2>/dev/null || echo '<unreadable cwd>') is not inside a git worktree"; exit 3; }
[[ -d ops && -d queue ]] || {
  echo "cannot measure: no ops/ and no queue/ under $(pwd)"; exit 3; }
[[ -f ops/queue-check ]] || {
  echo "cannot measure: ops/queue-check is not in this tree"; exit 3; }
# Without ops/lib there is nothing to run and nothing to enumerate, so the coverage assertion below would
# pass on an empty set - the shape of vacuous pass this whole file is written against.
[[ -d ops/lib ]] || {
  echo "cannot measure: no ops/lib/ under $(pwd), so there are no checks to run"; exit 3; }

findings=()

# ---------------------------------------------------------------- queue-check: EVERY problem, not tail -1
# `q="$(bash ops/queue-check | tail -1)"` was wrong twice over. The pipeline's exit status is tail's, so the
# check's own verdict was discarded; and the single line kept was whichever problem queue-check happened to
# print last. The caller then compared that ONE line against the previous branch's to decide whether a branch
# had introduced anything new - so a branch that added a brand-new duplicate task id, the defect this whole
# tool was built to catch, was printed as "(INHERITED, unchanged by this branch)" whenever the last line was
# unchanged. Under-blame is the same defect as over-blame, in the direction that loses the finding.
q="$(bash ops/queue-check 2>&1)"
qrc=$?
if [[ $qrc -ne 0 ]]; then
  n=0
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -n "$line" ]] || continue
    [[ "$line" == QUEUE\ CHECK\ FAIL* ]] && continue
    findings+=("queue-check: ${line#- }")
    n=$((n + 1))
  done <<<"$q"
  # A non-zero exit with nothing to say is still a failure. Reporting no finding for it would be the same
  # fail-open this file exists to remove.
  [[ $n -gt 0 ]] || findings+=("queue-check: exit $qrc with no problem lines")
fi

# ---------------------------------------------------------------- the ops/lib checks, by EXIT CODE
# The old function grepped for one message per check and ignored the exit code, so most real failures printed
# as "merged, gates clean": ops/lib/check-exec-bits has three failure messages and two were matched;
# ops/lib/check-line-cap has one today and six once T-0058 lands, of which one was matched. A check that says
# "I failed" is a failure whatever it says next.
#
# WHICH CHECKS - T-0091. This list was short by two, and that is how the collision this whole tool exists to
# find got past it. ops/lib/check-lock-lifecycle builds a ONE-task queue in a mktemp -d; T-0073 added a
# forty-task population floor to cmd_check; each guard is right on its own and together they are red. Two
# branches green alone and red merged is the definition of what a merge rehearsal is for - and this one could
# not see it, because check-lock-lifecycle was simply not in the set. It was found instead by an agent
# noticing a red check while working on something else, which is luck, not a process.
#
# Both additions are cheap by the standard this tool already applies. It skips ops/test because the swift,
# vitest and pytest tiers dominate the runtime by an order of magnitude; measured on the Windows checkout
# these two are 8s and 19s (almost all of it python process startup, x15), against ~2.5 min per row.
#
# And the list is no longer only a list: GATE_COVERAGE below asserts every ops/lib/check-* in the tree is IN
# it, because the next check added is invisible for exactly the same reason unless something notices.
GATE_CHECKS=(check-exec-bits check-line-cap check-brief-required check-lock-lifecycle)

# first_finding picks the line a reviewer needs, and it is PRESENTATION ONLY - the verdict is $rc, decided
# below. Three structural rules, no failure wording:
#   * an INDENTED line is a continuation of the one above, never the finding itself;
#   * a line beginning `ok:` is a case that PASSED. check-lock-lifecycle and check-brief-required log every
#     case, so the first line of a failing run is an `ok:` and quoting it would read as the opposite of what
#     happened;
#   * a header ending in `:` keeps the line under it, because `wrong git file mode:` names no file.
# If every line is filtered out - a check that changed its prose - it falls back to the LAST line, which for
# all four is the check's own verdict banner. Degrading to "LOCK LIFECYCLE FAIL" is safe; quoting a case that
# passed is not. (Precedent for wording in presentation while the verdict comes from the exit code: the
# queue-check block above drops the `QUEUE CHECK FAIL` banner by name and takes its answer from $qrc.)
first_finding() {
  local l1="" l2="" last="" line trimmed want2=0
  while IFS= read -r line; do
    trimmed="${line#"${line%%[![:space:]]*}"}"
    [[ -n "$trimmed" ]] || continue
    last="$trimmed"
    if [[ $want2 -eq 1 ]]; then l2="$trimmed"; want2=0; fi
    [[ -n "$l1" ]] && continue
    [[ "$line" == [[:space:]]* ]] && continue
    [[ "$trimmed" == ok:* ]] && continue
    l1="$trimmed"
    [[ "$l1" == *: ]] && want2=1
  done <<<"$1"
  if [[ -z "$l1" ]]; then printf '%s' "$last"
  elif [[ -n "$l2" ]]; then printf '%s %s' "$l1" "$l2"
  else printf '%s' "$l1"; fi
}

for chk in "${GATE_CHECKS[@]}"; do
  if [[ ! -f "ops/lib/$chk" ]]; then
    # Not "skip": main has all four, so a merged tree without one is a merge that deleted a check. Silently
    # skipping a missing check is how a rehearsal reports "clean" for a tree that removed its own gates.
    findings+=("$chk: NOT IN THIS TREE - a merge removed ops/lib/$chk")
    continue
  fi
  out="$(bash "ops/lib/$chk" 2>&1)"
  rc=$?
  case $rc in
    0) ;;
    1) findings+=("$chk: $(first_finding "$out") [exit $rc]") ;;
    *) # NOT a finding. 2 is "cannot reach the repo root" in check-brief-required and check-lock-lifecycle,
       # 126/127 are an unreadable script or a missing interpreter; none of them is a verdict about this
       # tree. Calling one a finding is the fabrication half of the same error as calling it clean, and the
       # caller must throw the run away rather than the row - hence exit 3, not findings+=.
       echo "cannot measure: ops/lib/$chk exited $rc, which is neither pass (0) nor findings (1):"
       printf '%s\n' "$out" | sed 's/^/  /'
       exit 3 ;;
  esac
done

# ---------------------------------------------------------------- GATE_COVERAGE: is that list complete?
# The structural half of T-0091. Adding two names above fixes the collision that was missed; it does not fix
# the reason it was missable, which is that the gate set is hand-maintained and nothing compared it against
# the checks the tree actually has. A check that exists and is not run is a check whose failure this tool
# will report as "gates clean", and that sentence is the thing this file was rewritten to stop saying.
#
# A finding rather than exit 3, deliberately: the gates that DID run are real measurements and the rows stand.
# What is false is the word "clean", so the row must carry the reason it is not entitled to it.
#
# NOTE the direction. The harness is fixed for a whole run (merge-rehearse runs THIS copy) while the checks
# come out of the merged tree, so a branch that ADDS a check trips this until the branch also adds it here.
# That is the intended ratchet: wiring a new check into the rehearsal is part of adding one.
shopt -s nullglob
for p in ops/lib/check-*; do
  [[ -f "$p" ]] || continue
  name="${p##*/}"
  known=0
  for chk in "${GATE_CHECKS[@]}"; do [[ "$name" == "$chk" ]] && known=1 && break; done
  [[ $known -eq 1 ]] || findings+=("gate-coverage: ops/lib/$name is a check in this tree that this rehearsal \
does not run, so a clean row does not cover it - add it to GATE_CHECKS in ops/lib/rehearse-gates")
done
shopt -u nullglob

# ---------------------------------------------------------------- duplicate pin ids
# ops/check-pins catches these too, but it is slow, so look directly. Keyed on the ID, not on the whole line:
# `grep '^- id:' | sort | uniq -d` compares "- id: P-OPS-01" against "- id: P-OPS-01 " and calls them
# different, so the same pin twice with one trailing space passed.
if [[ -f pins/PINS.yaml ]]; then
  dup="$(grep -oE '^-[[:space:]]+id:[[:space:]]*[A-Za-z0-9_.:-]+' pins/PINS.yaml \
         | sed -E 's/^-[[:space:]]+id:[[:space:]]*//' | sort | uniq -d)"
  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    findings+=("pins: duplicate pin id $d")
  done <<<"$dup"
fi

[[ ${#findings[@]} -eq 0 ]] && exit 0
printf '%s\n' "${findings[@]}"
exit 1
