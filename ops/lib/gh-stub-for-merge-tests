#!/usr/bin/env bash
# A deterministic stand-in for `gh`, used to exercise ops/merge's transient-state branches without racing
# GitHub. ops/merge only ever calls `gh repo view`, `gh pr view` and `gh pr merge`, so those are all it fakes.
#
#   STUB_STATE    what mergeStateStatus returns (default CLEAN)
#   STUB_ROLLUP   the statusCheckRollup JSON array (default two successful checks)
#   STUB_FLIP     if set, the FIRST call returns total=0/UNKNOWN and later calls return STUB_STATE/STUB_ROLLUP,
#                 which is what a real PR looks like in the seconds after a push
#   STUB_COUNT    path to a counter file used by STUB_FLIP
set -uo pipefail
state="${STUB_STATE:-CLEAN}"
# NOT `${STUB_ROLLUP:-[{...}]}`: bash brace-expands `{a,b}` inside the default, which silently shreds the JSON
# into multiple words. That cost a debugging round - the stub looked broken in exactly the way a real bug would.
if [[ -n "${STUB_ROLLUP:-}" ]]; then
  rollup="$STUB_ROLLUP"
else
  rollup='[{"name":"core","c":"SUCCESS"},{"name":"pins-source-only","c":"SUCCESS"}]'
fi

if [[ -n "${STUB_FLIP:-}" ]]; then
  # The counter advances on the mergeStateStatus call ONLY. ops/merge asks for mergeStateStatus first and
  # statusCheckRollup second within one loop iteration; incrementing on both made the two calls disagree, so
  # the rollup had already "flipped" to healthy while the state was still UNKNOWN - meaning total=0 was never
  # actually exercised and only the UNKNOWN branch was tested. reviewer-11 caught that.
  counter="${STUB_COUNT:-/tmp/gh-stub-count}"
  n=$(( $(cat "$counter" 2>/dev/null || echo 0) ))
  case "$*" in *mergeStateStatus*) echo $((n + 1)) > "$counter";; esac
  if [[ $n -lt 1 ]]; then state="UNKNOWN"; rollup="[]"; fi
fi

case "$*" in
  *"repo view"*)            echo "phineasfritsch/scenic_drive" ;;
  *"pr view"*headRefName*)  echo "tmp/stub-no-task" ;;
  *"pr view"*mergeStateStatus*) echo "$state" ;;
  *"pr view"*statusCheckRollup*) echo "$rollup" ;;
  *"pr view"*state*)        echo "MERGED" ;;
  *"pr merge"*)             echo "stub: would merge" ;;
  *) echo "gh-stub: unhandled: $*" >&2; exit 2 ;;
esac
