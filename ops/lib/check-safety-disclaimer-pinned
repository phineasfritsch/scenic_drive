# pinned_digest FILE: sha256 of FILE with CRLF normalized to LF; "missing" when FILE is not a readable file.
pinned_digest() {
  [[ -f "$1" && -r "$1" ]] || { echo "missing"; return 0; }
  sed -e 's/\r$//' "$1" | sha256sum | cut -c1-64
}

# pinned_module DIR LABEL SPECS_ARRAY_NAME: one module's file set, its index and every digest; set errors `fail` at
# once, digest mismatches are appended to PINNED_BAD. Run for FeatureScenicHome and (T-0273) FeatureSurpriseMe.
pinned_module() {
  local dir="${1%/}" label="$2"
  local -n specs="$3"
  [[ -d "$dir" ]] || fail "$PINNED_REASON: no such directory: $dir" \
    "The pinned set is $label; a missing tree is a refusal, never a pass."

  # Every entry, NO name filter (a filter runs before the whitelist and hides what it does not match), no link
  # followed or entered: the link itself is an entry, and (ii) refuses it by name.
  local found=() nonreg=() approved=() spec
  mapfile -t found < <(cd "$dir" && find . -mindepth 1 | sed -e 's|^\./||' | LC_ALL=C sort)
  mapfile -t nonreg < <(cd "$dir" && find . -mindepth 1 ! -type f | sed -e 's|^\./||' | LC_ALL=C sort)
  for spec in "${specs[@]}"; do approved+=("${spec%% *}"); done
  local added missing
  added="$(LC_ALL=C comm -23 <(printf '%s\n' "${found[@]}") <(printf '%s\n' "${approved[@]}" | LC_ALL=C sort) \
    | sed -e '/^$/d' | tr '\n' ' ')"
  missing="$(LC_ALL=C comm -13 <(printf '%s\n' "${found[@]}") <(printf '%s\n' "${approved[@]}" | LC_ALL=C sort) \
    | sed -e '/^$/d' | tr '\n' ' ')"
  local set_errs=()
  [[ -z "$added" ]] || set_errs+=("added ${added% }")
  [[ -z "$missing" ]] || set_errs+=("missing ${missing% }")
  [[ "${#nonreg[@]}" -eq 0 ]] || set_errs+=("not a regular file ${nonreg[*]}")
  [[ "${#set_errs[@]}" -eq 0 ]] || fail \
    "$PINNED_REASON: $label's file set is not the approved one: ${set_errs[*]}." \
    "Found ${#found[@]} entr(ies) under $dir; approved ${#approved[@]} regular files, typed in ops/lib/check-safety-disclaimer-pinned." \
    "A new file in the module can declare \`struct Text\`, \`VStack\` or \`AttributionFooter\` and every frozen line" \
    "then calls IT (rv3-t0237 R1); a directory link holding one is compiled and never listed (rv4-t0237). Any" \
    "entry that is not an approved regular file is refused by name; a file added, removed or renamed is approved there."

  # The index: a committed symlink checks out as a plain file where core.symlinks is false, so the checkout alone
  # cannot show it. No work tree (or no readable index) is a refusal - a limb that skips fails open.
  local links
  [[ "$(git -C "$dir" rev-parse --is-inside-work-tree 2>/dev/null)" == "true" ]] && \
    links="$(git -C "$dir" ls-files -s -- . 2>/dev/null)" || fail \
    "$PINNED_REASON: $dir is not inside a git work tree, so its index cannot be read." \
    "The pinned set refuses a mode-120000 (symlink) index entry, and an unread index is a refusal, never a pass."
  links="$(printf '%s\n' "$links" | sed -n -e 's/^120000 [0-9a-f]* [0-9]*\t//p' | tr '\n' ' ')"
  [[ -z "$links" ]] || fail "$PINNED_REASON: committed as a symlink ${links% } (git index mode 120000 under $dir)." \
    "A committed link can reach sources outside the pinned set; only regular files are approved (rv4-t0237)."

  local name want got
  for spec in "${specs[@]}"; do
    name="${spec%% *}"; want="${spec##* }"
    got="$(pinned_digest "$dir/$name")"
    [[ "$got" == "$want" ]] || PINNED_BAD+=("$name content changed (sha256 $got, approved $want)")
  done
  PINNED_FILES=$((PINNED_FILES + ${#found[@]}))
}

# require_pinned_surface FEATURE_DIR: both modules' file sets, then every digest, or `fail` naming each break at once.
require_pinned_surface() {
  local dir="${1%/}" got
  PINNED_BAD=()
  PINNED_FILES=0
  pinned_module "$dir" "FeatureScenicHome" PINNED_FEATURE
  pinned_module "$dir/$PINNED_SURPRISE_REL" "FeatureSurpriseMe" PINNED_SURPRISE
  got="$(pinned_digest "$dir/$PINNED_FOOTER_REL")"
  [[ "$got" == "$PINNED_FOOTER_DIGEST" ]] || \
    PINNED_BAD+=("AttributionFooter.swift content changed (sha256 $got, approved $PINNED_FOOTER_DIGEST)")
  [[ "${#PINNED_BAD[@]}" -eq 0 ]] || fail "$PINNED_REASON: ${PINNED_BAD[0]}" "${PINNED_BAD[@]:1}" \
    "Every byte of FeatureScenicHome, FeatureSurpriseMe and DesignSystem/AttributionFooter.swift is pinned (rv3-t0237" \
    "B1-B3: a file-scope \`private struct Text\`, \`VStack\` or \`AttributionFooter\` outside every frozen block blanked" \
    "the line, the sheet or the credit; T-0273: the card's Apple Maps tap). Approve an edit by typing its new digest" \
    "in the same commit, deliberately."
}
