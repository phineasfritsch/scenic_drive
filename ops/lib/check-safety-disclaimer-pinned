# require_pinned_app_swift APP_TREE: the app tree's Swift file set against PINNED_APP_SWIFT, then every digest.
require_pinned_app_swift() {
  local tree="${1%/}" found=() nonreg=() approved=() spec bad=() got added missing
  [[ -d "$tree" ]] || fail "$PINNED_REASON: no such directory: $tree" \
    "Every Swift file under the app tree is pinned; a missing tree is a refusal, never a pass."
  mapfile -t found < <(cd "$tree" && find . -mindepth 1 -iname '*.swift' | sed -e 's|^\./||' | LC_ALL=C sort)
  mapfile -t nonreg < <(cd "$tree" && find . -mindepth 1 -iname '*.swift' ! -type f | sed -e 's|^\./||' | LC_ALL=C sort)
  for spec in "${PINNED_APP_SWIFT[@]}"; do approved+=("${spec%% *}"); done
  added="$(LC_ALL=C comm -23 <(printf '%s\n' "${found[@]}") <(printf '%s\n' "${approved[@]}" | LC_ALL=C sort) \
    | sed -e '/^$/d' | tr '\n' ' ')"
  missing="$(LC_ALL=C comm -13 <(printf '%s\n' "${found[@]}") <(printf '%s\n' "${approved[@]}" | LC_ALL=C sort) \
    | sed -e '/^$/d' | tr '\n' ' ')"
  [[ -z "$added" ]] || bad+=("added ${added% }")
  [[ -z "$missing" ]] || bad+=("missing ${missing% }")
  [[ "${#nonreg[@]}" -eq 0 ]] || bad+=("not a regular file ${nonreg[*]}")
  [[ "${#bad[@]}" -eq 0 ]] || fail "$PINNED_REASON: the app's Swift file set is not the approved one: ${bad[*]}." \
    "Found ${#found[@]} *.swift entr(ies) under $tree; approved ${#approved[@]}, typed in ops/lib/check-safety-disclaimer-pinned." \
    "A new Swift file in any module can open a URL through a spelling no opener list names (rv2-t0273 B1:" \
    "\`let go = scene.open\` in a new MapAdapter file). Approve an added, removed or renamed file there."
  pinned_raw "$tree" "${approved[@]}"
  for spec in "${PINNED_APP_SWIFT[@]}"; do
    [[ "${PINNED_RAW["${spec%% *}"]-}" == "${spec##* }" ]] && continue
    got="$(pinned_digest "$tree/${spec%% *}")"
    [[ "$got" == "${spec##* }" ]] || bad+=("${spec%% *} content changed (sha256 $got, approved ${spec##* })")
  done
  [[ "${#bad[@]}" -eq 0 ]] || fail "$PINNED_REASON: ${bad[0]}" "${bad[@]:1}" \
    "Every byte of every Swift file under $tree is pinned (rv2-t0273 B1). Approve an edit by typing its new digest" \
    "in ops/lib/check-safety-disclaimer-pinned in the same commit, deliberately - \`sed -e 's/\r\$//' FILE | sha256sum\`."
  PINNED_APP_FILES="${#found[@]}"
  require_pinned_linked "$tree"  # T-0289: pbxproj, apps/ios beyond Swift, the root package - LAST
}
