# Trimmed whole lines naming previewMap / PlanPreviewMap / PlanPreviewCard / planContent or passing `map:` anywhere,
# or naming `map` in the card; only a line STARTING with // and holding no backslash is dropped (B1 rv1-t0295: a //
# line with a backslash can be code inside a string).
preview_wiring_lines() {
  awk -v root="$APP_TREE/" '
    {
      line = $0; sub(/\r$/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line)
      if (substr(line, 1, 2) == "//" && index(line, "\\") == 0) next
      if (line !~ /(^|[^A-Za-z0-9_])(previewMap|PlanPreviewMap|PlanPreviewCard|planContent)([^A-Za-z0-9_]|$)/ &&
          line !~ /(^|[^A-Za-z0-9_])map[ \t]*:/ &&
          !(FILENAME ~ /FeaturePlanSheet\/PlanPreviewCard\.swift$/ && line ~ /(^|[^A-Za-z0-9_])map([^A-Za-z0-9_]|$)/)) next
      rel = FILENAME
      if (index(FILENAME, root) == 1) rel = substr(FILENAME, length(root) + 1)
      printf "%s: %s\n", rel, line
    }
  ' "$@"
}
require_preview_wiring() {
  [[ "${1:-}" == "--" ]] && shift
  FROZEN_BAD=()
  frozen_block "$APP_TREE/$PREVIEW_MAP_REL" "PlanPreviewMap's struct (the map, then its credit over it)" \
    FROZEN_PREVIEW_MAP "import SwiftUI"
  frozen_block "$APP_TREE/$PLAN_SHEET_REL" "PlanSheetScreen's body (content and its modifiers)" FROZEN_PLAN_BODY "}"
  frozen_block "$APP_TREE/$PLAN_SHEET_REL" "PlanSheetScreen's content (planContent on the plan tab)" \
    FROZEN_PLAN_CONTENT "}"
  frozen_block "$APP_TREE/$PLAN_SHEET_REL" "PlanSheetScreen's planContent (the whole switch, every arm)" \
    FROZEN_PLAN_SWITCH "}"
  local found=() w
  mapfile -t found < <(preview_wiring_lines "$@")
  if [[ "$(printf '%s\n' "${found[@]}")" != "$(printf '%s\n' "${PREVIEW_WIRING[@]}")" ]]; then
    FROZEN_BAD+=("${#found[@]} line(s) name previewMap / PlanPreviewMap / PlanPreviewCard / planContent, pass \`map:\` (or name \`map\` in PlanPreviewCard.swift), ${#PREVIEW_WIRING[@]} approved; found, in scan order:")
    for w in "${found[@]}"; do FROZEN_BAD+=("  $w"); done
  fi
  [[ "${#FROZEN_BAD[@]}" -eq 0 ]] || fail "the plan preview's map is not wired and drawn as approved (f4):" \
    "${FROZEN_BAD[@]}" \
    "The preview's ONLY credit is PlanPreviewMap's footer: the shell builds it, PlanSheetScreen's ONE .preview arm" \
    "hands it to the ONE PlanPreviewCard construction as \`map\`, and the footer is drawn AFTER MapView in its ZStack," \
    "so over it. rv0-t0405 M-A handed the card an empty view, M-B drew the map over the credit, rv1 B1 shadowed the" \
    "arm with a duplicate above it and B2 faded planContent out; every other limb was green on each. Each block is a" \
    "whole-line whitelist - an edit is refused until this list is edited in the same commit."
  echo "P-ATTR-01 (f4): PlanPreviewMap's struct and PlanSheetScreen's body, content and planContent frozen whole;" \
    "${#found[@]} approved line(s) name previewMap, PlanPreviewMap, PlanPreviewCard, planContent or pass \`map:\`."
}
