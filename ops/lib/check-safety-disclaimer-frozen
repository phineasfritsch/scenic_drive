# Every line of one file that can hold code: trailing CR stripped, trimmed, blank lines kept; only a line whose
# trimmed text STARTS with // is dropped.
frozen_code_lines() {
  awk '{ line = $0; sub(/\r$/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line)
         if (substr(line, 1, 2) == "//") next; print line }' "$1"
}

# frozen_block FILE LABEL ARRAY ABOVE: one reason appended to FROZEN_BAD when the block is not its approved list.
frozen_block() {
  local file="$1" label="$2" above="$4" ob='{' cb='}'
  local -n want="$3"
  if [[ ! -f "$file" ]]; then FROZEN_BAD+=("$label: no such file $file"); return; fi
  local kept=() i at=-1 n=0
  mapfile -t kept < <(frozen_code_lines "$file")
  for i in "${!kept[@]}"; do
    [[ "${kept[$i]}" == "${want[0]}" ]] || continue
    n=$((n + 1)); at="$i"
  done
  if [[ "$n" -ne 1 ]]; then
    FROZEN_BAD+=("$label: the whole line \`${want[0]}\` occurs $n time(s) in $file, expected exactly 1"); return
  fi
  local up="<start of file>" k
  for ((k = at - 1; k >= 0; k--)); do [[ -n "${kept[$k]}" ]] && { up="${kept[$k]}"; break; }; done
  if [[ "$up" != "$above" ]]; then
    FROZEN_BAD+=("$label: the line above \`${want[0]}\` is \`$up\`, approved \`$above\` (an attribute there rewrites the block)")
    return
  fi
  local got=() depth=0 j o c line
  for ((j = at; j < ${#kept[@]}; j++)); do
    line="${kept[$j]}"; got+=("$line")
    o="${line//[!$ob]/}"; c="${line//[!$cb]/}"
    depth=$((depth + ${#o} - ${#c}))
    [[ "$depth" -gt 0 ]] || break
  done
  if [[ "$depth" -gt 0 ]]; then
    FROZEN_BAD+=("$label: \`${want[0]}\` never closes in $file (braces counted on whole lines)"); return
  fi
  for j in "${!want[@]}"; do
    [[ "${got[$j]-<end of block>}" == "${want[$j]}" ]] && continue
    FROZEN_BAD+=("$label line $((j + 1)) of ${#want[@]} in $file: approved \`${want[$j]}\`, found \`${got[$j]-<end of block>}\`")
    return
  done
  [[ "${#got[@]}" -eq "${#want[@]}" ]] || \
    FROZEN_BAD+=("$label in $file: ${#got[@]} lines, approved ${#want[@]}; the first unapproved is \`${got[${#want[@]}]}\`")
}

# frozen_directives FILE: every kept line starting with `#` must be an approved "basename|line" entry (none are).
frozen_directives() {
  local file="$1" line ok d
  while IFS= read -r line; do
    [[ "$line" == "#"* ]] || continue
    ok=0
    for d in "${FROZEN_DIRECTIVES[@]}"; do [[ "$d" == "${file##*/}|$line" ]] && ok=1; done
    [[ "$ok" -eq 1 ]] || FROZEN_BAD+=("${file##*/}: the line \`$line\` - a directive in a frozen file, none approved")
  done < <(frozen_code_lines "$file")
}

# require_frozen_blocks FEATURE_DIR APP_TREE: the six blocks and the directive fence, or `fail` naming each break.
require_frozen_blocks() {
  local feature="$1" app_tree="$2" f
  local sheet="$feature/HomeSheet.swift" screen="$feature/ScenicHomeScreen.swift"
  local shell="$app_tree/ScenicDrive/ScenicDriveApp.swift"
  FROZEN_BAD=()
  frozen_block "$sheet" "HomeSheet's struct" FROZEN_HOME_SHEET "import SwiftUI"
  frozen_block "$screen" "ScenicHomeScreen's body (the ZStack and its modifier chain)" FROZEN_SCREEN_BODY "public init() {}"
  frozen_block "$screen" "ScenicHomeScreen's chips" FROZEN_CHIPS "}"
  frozen_block "$screen" "ScenicHomeScreen's sheetDetails" FROZEN_SHEET_DETAILS "}"
  frozen_block "$screen" "ScenicHomeScreen's conditions" FROZEN_CONDITIONS "}"
  frozen_block "$shell" "the app shell ScenicDriveApp" FROZEN_APP_SHELL "@main"
  for f in "$sheet" "$screen" "$shell"; do [[ -f "$f" ]] && frozen_directives "$f"; done
  [[ "${#FROZEN_BAD[@]}" -eq 0 ]] || fail "$FROZEN_REASON:" "${FROZEN_BAD[@]}" \
    "These blocks draw the sheet, the conditions line and the credit at BOTH detents; each is a whole-line whitelist" \
    "(ops/lib/check-safety-disclaimer-frozen). An edit inside one - a wrapper, a modifier, an overlay, a moved line -" \
    "is refused until the approved list is edited in the same commit, where a reviewer reads it (rv2-t0237 B1-B3)."
}
