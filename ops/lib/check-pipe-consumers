#!/usr/bin/env bash
# No gate may decide anything from `producer | grep -q` (T-0140).
#
# `grep -q` exits at its FIRST match. If the producer is still writing, it gets SIGPIPE and exits 141, and
# under `set -o pipefail` - which every gate here runs with, and which ops/lib/pins.py imposes on every pin
# assertion - the pipeline's status is 141, not grep's 0. The verdict then depends on a race between how
# much the producer writes after the match and how fast grep returns:
#
#     bash -o pipefail -c "(echo 'Test run with 20 tests passed'; seq 1 200000) | grep -q passed"   -> 141
#     bash -o pipefail -c "(echo 'Test run with 20 tests passed'; seq 1 200000) | grep passed >/dev/null" -> 0
#
# P-SAFE-05 lost that race 1 run in 3 on one reviewer's box (swift test kept writing after its summary
# line) and never here in 10 - which is exactly what makes it a flake rather than a failure, and why two
# independent reviewers reported it in one night. ops/merge:45 had the same shape on the merge gate itself:
# a SIGPIPE from `gh api` reads as "task not in queue/done/" and refuses a merge that should land.
#
# The fix is one character class: `grep PAT >/dev/null` reads ALL of stdin and exits on its own result.
# This check keeps the shape from coming back. It is a text scan, so it is anchored on the command text,
# not on a comment - `grep -q` is the identifier.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.." || { echo "cannot reach the repo root"; exit 2; }
[[ -f ops/lib/pins.py ]] || { echo "$(pwd) is not the repo root"; exit 2; }

# SCANNED: tracked plus untracked-unignored, so a file being written is scanned before it is committed.
# That is why --others is here: the first version scanned tracked files only, passed over
# ops/lib/check-secret-scan.py while it was still untracked, and failed in CI the moment it was committed.
mapfile -t files < <(git ls-files --cached --others --exclude-standard -- ops .githooks pins/PINS.yaml)
mapfile -t tracked < <(git ls-files -- ops .githooks pins/PINS.yaml)

# A COUNT EQUALITY IS A FACT ABOUT THE BASE BRANCH, NOT THE COMMIT (agent/rv2-pr87, BLOCKING 1). CI checks
# out refs/pull/N/merge, so files main adds under these paths after the merge-base are in the count: 40
# tracked at ffa9b6c, 42 on this branch, 43 on main, 45 in the union - exactly what CI printed while the
# constant said 42. Once merged, every PR adding a file under ops/ would go red until renumbered, and two
# such PRs could never both be green. Three CI failures of this PR on its own check: one on a docstring quoting the shape, two on this count.
#
# So the enumeration is proven by IDENTIFIERS, not by a number: the files that carried the class must be in
# the scanned set (a scan that lost .githooks/ cannot claim to have looked), each pathspec must have
# enumerated at least one tracked file, and the count is a FLOOR at the smallest real value - a lower bound
# only detects a truncated tree, which is what it is for, and cannot be beaten by a file arriving on main.
for must in .githooks/pre-commit ops/merge ops/deploy ops/sane ops/lib/check-failure-naming pins/PINS.yaml; do
  if ! printf '%s\n' "${files[@]}" | grep -x -- "$must" >/dev/null; then
    echo "PIPE-CONSUMERS REFUSING: $must is not in the scanned set - the tree did not enumerate"
    exit 2
  fi
done
for root in ops/ .githooks/; do
  if ! printf '%s\n' "${tracked[@]}" | grep -- "^$root" >/dev/null; then
    echo "PIPE-CONSUMERS REFUSING: no tracked file under $root - the tree did not enumerate"
    exit 2
  fi
done
MIN_TRACKED=42
if (( ${#tracked[@]} < MIN_TRACKED )); then
  echo "PIPE-CONSUMERS REFUSING: ${#tracked[@]} tracked file(s), fewer than the $MIN_TRACKED recorded - the tree did not enumerate"
  exit 2
fi
if (( ${#files[@]} < ${#tracked[@]} )); then
  echo "PIPE-CONSUMERS REFUSING: scanned ${#files[@]} but ${#tracked[@]} are tracked - the scan is missing files git knows about"
  exit 2
fi

# The pattern. A pipe (`|` or `|&`), then grep/egrep/fgrep, then any run of flags and words, then a flag
# that makes it exit early: -q in any short group (quoted or not), --quiet, --silent, -m<N>, --max-count.
# Round 1 caught only a -q in the FIRST short group after grep; round 3 (agent/rv2-pr87) added the quoted
# form, |&, --max-count, and a line that ENDS in a pipe with the consumer on the next line - awk joins
# those before matching, so a continuation cannot hide the consumer.
PATTERN='\|&?[[:space:]]*(grep|egrep|fgrep)([[:space:]]+[^|;&]*)?[[:space:]]+["'"'"']?(-[A-Za-z]*q[A-Za-z]*|--quiet|--silent|-m[[:space:]]*[0-9]+|--max-count(=|[[:space:]]+)[0-9]+)["'"'"']?([[:space:]]|$)'

hits=0
scanned=0
scan="$(mktemp)"
trap 'rm -f "$scan"' EXIT
for f in "${files[@]}"; do
  [[ "$f" == "ops/lib/check-pipe-consumers" ]] && continue   # this file quotes the shape on purpose
  # NOT a pipeline. awk writes the joined lines to a temp file and its OWN exit status is read: the first
  # version of this loop ran awk inside a process substitution, awk failed on every file (this gawk does
  # not take `--`), zero hits were counted, and the check printed OK over nothing - the exact fail-open
  # this file exists to forbid, one level up. A scan that did not run is refused, not passed.
  if ! awk '{ if (prev != "") { $0 = prev " " $0; prev = "" } if ($0 ~ /\|[[:space:]]*$/) { prev = $0; next } print NR ":" $0 }' "$f" > "$scan"; then
    echo "PIPE-CONSUMERS REFUSING: the scan failed to run on $f"
    exit 2
  fi
  scanned=$((scanned + 1))
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    echo "PIPE-CONSUMERS: $f:$line"
    hits=$((hits + 1))
  done < <(grep -E "$PATTERN" "$scan" | grep -vE '^[0-9]+:[[:space:]]*#')
done

expected=$(( ${#files[@]} - 1 ))   # every scanned file but this one
if (( scanned != expected )); then
  echo "PIPE-CONSUMERS REFUSING: scanned $scanned of $expected files"
  exit 2
fi
if (( hits > 0 )); then
  echo "PIPE-CONSUMERS FAIL: $hits pipeline(s) decide with grep -q; use 'grep PAT >/dev/null' so the producer is read to EOF ($scanned scanned, ${#tracked[@]} tracked, floor $MIN_TRACKED)"
  exit 1
fi
echo "PIPE-CONSUMERS OK: no gate decides with 'producer | grep -q' ($scanned scanned, ${#tracked[@]} tracked, floor $MIN_TRACKED)"
