#!/usr/bin/env bash
# No gate may decide anything from `producer | grep -q` (T-0140).
#
# `grep -q` exits at its FIRST match. If the producer is still writing, it gets SIGPIPE and exits 141, and
# under `set -o pipefail` - which every gate here runs with, and which ops/lib/pins.py imposes on every pin
# assertion - the pipeline's status is 141, not grep's 0. The verdict then depends on a race between how
# much the producer writes after the match and how fast grep returns:
#
#     bash -o pipefail -c "(echo 'Test run with 20 tests passed'; seq 1 200000) | grep -q passed"   -> 141
#     bash -o pipefail -c "(echo 'Test run with 20 tests passed'; seq 1 200000) | grep passed >/dev/null" -> 0
#
# P-SAFE-05 lost that race 1 run in 3 on one reviewer's box (swift test kept writing after its summary
# line) and never here in 10 - which is exactly what makes it a flake rather than a failure, and why two
# independent reviewers reported it in one night. ops/merge:45 had the same shape on the merge gate itself:
# a SIGPIPE from `gh api` reads as "task not in queue/done/" and refuses a merge that should land.
#
# The fix is one character class: `grep PAT >/dev/null` reads ALL of stdin and exits on its own result.
# This check keeps the shape from coming back. It is a text scan, so it is anchored on the command text,
# not on a comment - `grep -q` is the identifier.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.." || { echo "cannot reach the repo root"; exit 2; }
[[ -f ops/lib/pins.py ]] || { echo "$(pwd) is not the repo root"; exit 2; }

# What is scanned: every file under ops/ and .githooks/ that git knows or would add, plus the pin file -
# the places a verdict is computed. `--cached --others --exclude-standard`, not plain `ls-files`: the first
# version scanned tracked files only, passed locally over ops/lib/check-secret-scan.py while it was still
# UNTRACKED, and failed in CI the moment it was committed - the check saw everything except the file being
# written. Ignored paths (.artifacts/) stay out, so scratch cannot fail it; a tree that failed to
# enumerate reports a COUNT rather than a clean sheet.
# SCANNED: tracked plus untracked-unignored, so a file being written is scanned before it is committed.
# That is why --others is here: the first version scanned tracked files only, passed over
# ops/lib/check-secret-scan.py while it was still untracked, and failed in CI the moment it was committed.
mapfile -t files < <(git ls-files --cached --others --exclude-standard -- ops .githooks pins/PINS.yaml)
# COUNTED: what git TRACKS, which is a fact about the commit and the same on every machine. EQUAL, not a
# floor - with a floor of 20 over 42 files, dropping .githooks from the path list scanned 40 and printed OK
# with both original hook sites back in the tree (agent/rv-pr87, BLOCKING 3).
#
# The count and the scan are deliberately NOT the same set. Asserting the equality over the scanned set is
# what failed CI at c986b2a: `scanned 44 files, EXPECTED_FILES says 42`, because two untracked-unignored
# files existed on the runner and not here. A population claim that moves with the machine is not a
# population claim. Adding a tracked file under these paths means changing this number, on purpose, in the
# same commit.
mapfile -t tracked < <(git ls-files -- ops .githooks pins/PINS.yaml)
EXPECTED_TRACKED=42
if (( ${#tracked[@]} != EXPECTED_TRACKED )); then
  echo "PIPE-CONSUMERS REFUSING: ${#tracked[@]} tracked file(s), EXPECTED_TRACKED says $EXPECTED_TRACKED - the tree did not enumerate as recorded"
  exit 2
fi
if (( ${#files[@]} < ${#tracked[@]} )); then
  echo "PIPE-CONSUMERS REFUSING: scanned ${#files[@]} but ${#tracked[@]} are tracked - the scan is missing files git knows about"
  exit 2
fi

hits=0
for f in "${files[@]}"; do
  [[ "$f" == "ops/lib/check-pipe-consumers" ]] && continue   # this file quotes the shape on purpose
  # A pipe, then grep/egrep/fgrep, then ANY run of flags and words, then a flag that makes it exit early:
  # -q in any short group, --quiet, --silent, or -m<N> (stop after N matches). The first version matched
  # only a -q in the FIRST short group directly after `grep`, so `grep -E -q`, `grep -e PAT -q`,
  # `grep --quiet`, `egrep -q` all passed - each measured exit 141 under the chatty producer above
  # (agent/rv-pr87, BLOCKING 2). The statement of P-OPS-03 is "every such pipeline"; the regex has to be.
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    echo "PIPE-CONSUMERS: $f:$line"
    hits=$((hits + 1))
  done < <(grep -nE '\|[[:space:]]*(grep|egrep|fgrep)([[:space:]]+[^|;&]*)?[[:space:]]+(-[A-Za-z]*q[A-Za-z]*|--quiet|--silent|-m[[:space:]]*[0-9]+)([[:space:]]|$)' -- "$f" | grep -vE '^[0-9]+:[[:space:]]*#')
done

if (( hits > 0 )); then
  echo "PIPE-CONSUMERS FAIL: $hits pipeline(s) decide with grep -q; use 'grep PAT >/dev/null' so the producer is read to EOF (${#files[@]} scanned, ${#tracked[@]} tracked)"
  exit 1
fi
echo "PIPE-CONSUMERS OK: no gate decides with 'producer | grep -q' (${#files[@]} scanned, ${#tracked[@]} tracked)"
