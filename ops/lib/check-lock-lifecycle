#!/usr/bin/env bash
# An exclusive lock is released when the work stops, and only by the task that holds it.
#
# The property, over the one tool that moves tasks:
#
#     claim T          =>  LOCKS/<res>.lock exists and names T
#     review T         =>  the lock is gone, T is in review/, and queue-check is clean
#     a hand `git mv`  =>  the lock survives and queue-check FAILS - which is why `review` exists
#     lock held by U   =>  review T releases nothing and moves nothing
#     reviewer == owner=>  refused
#
# Why this exists: there was no claimed -> review transition in code at all. Every agent did `git mv` plus a
# hand edit, so nothing ran at the moment the work stopped and the lock was never released. `cmd_check`
# already treats an orphaned lock as an error, so the first task to carry one into review/ would have failed
# `ops/queue-check` for every agent in every worktree. Exactly one lock exists today (scenic-index, held by
# T-0024, still claimed) and it had not happened yet.
#
# Anchored on the executable and on generated task fixtures, never on a comment.
set -uo pipefail
# Not `git rev-parse --show-toplevel`: from WSL against a Windows worktree it prints an unusable path and,
# without set -e, leaves the script running in whatever directory it started in (T-0055).
cd "$(dirname "${BASH_SOURCE[0]}")/../.." || { echo "cannot reach the repo root"; exit 2; }
[[ -f ops/lib/queue.py ]] || { echo "$(pwd) is not the repo root (no ops/lib/queue.py)"; exit 2; }

PY="${PYTHON:-$(command -v python3 || command -v python)}"
# Repo-root-relative, and the status is checked. NOT `$(dirname "${BASH_SOURCE[0]}")/tmpdir.sh`: line 22 has
# already cd'd, so a relative BASH_SOURCE (`cd ops && bash lib/check-lock-lifecycle`) no longer resolves, and
# with no `set -e` the failure was silent - TMP="" and the next line became `rm -rf "/queue" "/ops" "/.git"`.
# shellcheck source=ops/lib/tmpdir.sh
source ops/lib/tmpdir.sh || { echo "cannot source ops/lib/tmpdir.sh from $(pwd)"; exit 2; }
TMP="$(portable_mktemp_d)" || { echo "cannot make a temp directory"; exit 2; }
[[ -n "$TMP" ]] || { echo "portable_mktemp_d returned an empty path; refusing to rm -rf from /"; exit 2; }
trap 'rm -rf "$(portable_posix_path "$TMP")"' EXIT
fail=0
Q="$TMP/ops/lib/queue.py"

reset_repo() {
  rm -rf "$TMP/queue" "$TMP/ops" "$TMP/.git"
  mkdir -p "$TMP/ops/lib" "$TMP/queue"/{backlog,ready,claimed,review,blocked,done,LOCKS}
  cp ops/lib/queue.py "$Q"

  # A REAL git repo with a main branch, because cmd_review rehearses the merge: it reads `main` to decide
  # whether merging this branch would leave two copies of the task file. Against a bare directory it
  # refuses with "cannot read main", which is fail-closed and correct - and which made cases 3 and 4 of
  # this check fail the first time it ever ran on the Windows box, after the mktemp path was fixed.
  #
  # MAIN MUST ACTUALLY TRACK queue/. The first version of this fixture ran `git add -A` before any task file
  # existed, so main's tree held only ops/lib/queue.py; `_would_duplicate_on_merge` iterates
  # `git ls-tree -r --name-only main queue/`, which returned ZERO paths, so its loop body never executed and
  # it returned [] no matter what. Deleting the rehearsal outright produced byte-identical output - the
  # fixture proved that cmd_review can get PAST the rehearsal, not that the rehearsal works (reviewer-pr79
  # F4). So: .gitkeep in every state dir, plus one committed task that is NOT the subject of any case, so
  # the loop body runs and the `/{tid}-` filter is exercised in the negative direction too. Case 8 exercises
  # it in the positive direction.
  local d
  for d in backlog ready claimed review blocked done LOCKS; do : > "$TMP/queue/$d/.gitkeep"; done
  make_task T-9200 "" ready
  (
    cd "$TMP" || exit 1
    git init -q -b main
    git config user.email "probe@example.invalid"
    git config user.name "probe"
    git config commit.gpgsign false
    git add -A >/dev/null 2>&1
    git -c core.hooksPath=/dev/null commit -q -m "fixture base" --allow-empty
    git checkout -q -b task/T-9999
  )
}

# $1 = id, $2 = exclusive list body (e.g. "scenic-index"), $3 = state dir
# The title and the brief both carry the id: the fixture now holds more than one task at a time, and
# cmd_check reports "N tasks share one title" / "N tasks share one brief" (T-0070's duplicate guard) for
# identical ones. A fixture that trips an unrelated guard is a fixture that hides its own subject.
make_task() {
  local id="$1" excl="$2" dir="${3:-ready}"
  { printf -- '---\nid: %s\ntitle: demo %s\nstate: %s\nowner: agent/alice\nowner_session: null\n' "$id" "$id" "$dir"
    printf -- 'claimed_at: null\nlease_expires_at: null\nworktree: null\nbranch: null\n'
    printf -- 'exclusive: [%s]\ntouches: [ops/]\npins_affected: []\nreviewer: null\ndepends_on: []\n' "$excl"
    printf -- 'verify: [ops/test]\nacceptance: []\n---\n## Brief\n\nA real sentence about %s, so the brief guard passes.\n\n## Log\n' "$id"
  } > "$TMP/queue/$dir/$id-demo.md"
}

say() { printf '%s\n' "$1"; }
bad() { echo "FAIL: $1"; fail=1; }

# ---------------------------------------------------------------- 1. claim takes the lock
reset_repo
make_task T-9101 scenic-index
"$PY" "$Q" claim T-9101 --owner agent/alice >/dev/null 2>&1
if [[ -f "$TMP/queue/LOCKS/scenic-index.lock" ]] && grep -q "^T-9101 " "$TMP/queue/LOCKS/scenic-index.lock"; then
  say "ok: claim takes the lock and names the task"
else
  bad "claim did not take the lock"
fi

# ---------------------------------------------------------------- 2. the hand transition, which is the bug
# Reproduce exactly what every agent did before this command existed: move the file and edit the fields.
mv "$TMP/queue/claimed/T-9101-demo.md" "$TMP/queue/review/T-9101-demo.md"
sed -i 's/^state: claimed$/state: review/; s|^reviewer: null$|reviewer: agent/bob|' "$TMP/queue/review/T-9101-demo.md"
out="$("$PY" "$Q" check 2>&1)"
if grep -q "scenic-index.lock held by T-9101" <<<"$out"; then
  say "ok: a hand git mv leaves the lock and queue-check FAILS - the red run this command exists for"
  say "    $(grep 'scenic-index.lock' <<<"$out" | head -1 | sed 's/^ *//')"
else
  bad "a hand transition did not produce the orphaned-lock failure; premise not reproduced"
  printf '    %s\n' "$out" | head -3
fi

# ---------------------------------------------------------------- 3. the command releases it
reset_repo
make_task T-9102 scenic-index
"$PY" "$Q" claim T-9102 --owner agent/alice >/dev/null 2>&1
"$PY" "$Q" review T-9102 --reviewer agent/bob >/dev/null 2>&1
if [[ -f "$TMP/queue/LOCKS/scenic-index.lock" ]]; then
  bad "review did not release the lock"
elif [[ ! -f "$TMP/queue/review/T-9102-demo.md" ]]; then
  bad "review did not move the task"
else
  out="$("$PY" "$Q" check 2>&1)"
  # The property THIS check owns is the lock, not the whole queue's health. Demanding a bare `QUEUE OK` here
  # also demanded that the fixture clear cmd_check's MIN_TASKS floor of 40, which a fixture of a handful of
  # tasks cannot - so this case failed for a reason that belongs to T-0091 (claimed by another agent), and
  # check-lock-lifecycle's exit code was a constant 1 whether the subject was healthy or broken: baseline,
  # "lock never released" and "self-review accepted" were indistinguishable to any gate (reviewer-pr79 F3).
  #
  # So: every problem cmd_check reports must be gone EXCEPT the floor, whose text is written out here by
  # hand as the single exemption. Any other problem line, including a new one, still fails this case. The
  # verdict line is required first, so a crashed cmd_check cannot pass by printing no problems at all.
  residual="$(grep '^ - ' <<<"$out" | grep -v 'floor is 40')"
  if ! grep -qE '^(QUEUE OK|QUEUE CHECK FAIL)' <<<"$out"; then
    bad "queue-check did not reach a verdict after review: $(head -2 <<<"$out")"
  elif [[ -n "$residual" ]]; then
    bad "queue-check reported a problem other than the MIN_TASKS floor after review:"
    printf '    %s\n' "$residual"
  else
    say "ok: review releases the lock, moves the task, and queue-check reports nothing but the known floor"
  fi
fi

# ---------------------------------------------------------------- 4. a task with no locks still transitions
reset_repo
make_task T-9103 ""
"$PY" "$Q" claim T-9103 --owner agent/alice >/dev/null 2>&1
if "$PY" "$Q" review T-9103 --reviewer agent/bob >/dev/null 2>&1 \
   && [[ -f "$TMP/queue/review/T-9103-demo.md" ]]; then
  say "ok: a task declaring no exclusive resources still moves"
else
  bad "review refused a task that holds no locks"
fi

# ---------------------------------------------------------------- 5. reviewer == owner is refused
reset_repo
make_task T-9104 ""
"$PY" "$Q" claim T-9104 --owner agent/alice >/dev/null 2>&1
out="$("$PY" "$Q" review T-9104 --reviewer agent/alice 2>&1)"; rc=$?
if [[ $rc -ne 0 ]] && grep -qi "may not grade its own work" <<<"$out" \
   && [[ -f "$TMP/queue/claimed/T-9104-demo.md" ]]; then
  say "ok: reviewer == owner refused, and the task did not move"
else
  bad "reviewer == owner was accepted (rc=$rc): $out"
fi

# ---------------------------------------------------------------- 6. a foreign lock is never taken over
reset_repo
make_task T-9105 scenic-index
"$PY" "$Q" claim T-9105 --owner agent/alice >/dev/null 2>&1
# Somebody else's lock, under a resource this task also declares.
printf 'T-9999 agent/carol 2026-01-01T00:00:00Z\n' > "$TMP/queue/LOCKS/scenic-index.lock"
out="$("$PY" "$Q" review T-9105 --reviewer agent/bob 2>&1)"; rc=$?
if [[ $rc -ne 0 ]] \
   && [[ -f "$TMP/queue/LOCKS/scenic-index.lock" ]] \
   && grep -q "^T-9999 " "$TMP/queue/LOCKS/scenic-index.lock" \
   && [[ -f "$TMP/queue/claimed/T-9105-demo.md" ]]; then
  say "ok: a lock held by another task is left alone and the transition refuses"
else
  bad "a foreign lock was released or the task moved anyway (rc=$rc): $out"
fi

# ---------------------------------------------------------------- 7. only ready tasks are claimable; only
#                                                                     claimed ones reviewable
reset_repo
make_task T-9106 "" done
out="$("$PY" "$Q" review T-9106 --reviewer agent/bob 2>&1)"; rc=$?
if [[ $rc -ne 0 ]] && grep -q "not claimed/" <<<"$out"; then
  say "ok: a task already in done/ cannot be handed to review"
else
  bad "review accepted a task that was not claimed (rc=$rc): $out"
fi

# ---------------------------------------------------------------- 8. the merge rehearsal, driven POSITIVE
# Cases 3-7 all take the rehearsal's empty branch. Nothing took the non-empty one, so `_would_duplicate_on_merge`
# could be replaced by `return []` without changing a byte of this check's output (reviewer-pr79 F4).
#
# The real shape: `ops/claim` moves ready/ -> claimed/ ON MAIN, and a stacked worktree is cut from a base
# that predates that commit. The branch then writes its own copy at the same path - an independent add that
# shares no history with main's, so git keeps BOTH and queue-check fails only on the merged tree. Eleven
# branches were repaired by hand for this (T-0063), and cmd_review must refuse before anything moves.
reset_repo
(
  cd "$TMP" || exit 1
  git checkout -q main
  mkdir -p queue/claimed
  printf -- '---\nid: T-9107\ntitle: demo T-9107\nstate: claimed\n---\n## Brief\n\nmain copy.\n' \
    > queue/claimed/T-9107-demo.md
  git add queue/claimed/T-9107-demo.md >/dev/null 2>&1
  git -c core.hooksPath=/dev/null commit -q -m "main claims T-9107"
  git checkout -q task/T-9999
)
make_task T-9107 ""
"$PY" "$Q" claim T-9107 --owner agent/alice >/dev/null 2>&1
out="$("$PY" "$Q" review T-9107 --reviewer agent/bob 2>&1)"; rc=$?
if [[ $rc -ne 0 ]] \
   && grep -q "main holds this task where this branch cannot delete it" <<<"$out" \
   && grep -q "queue/claimed/T-9107-demo.md" <<<"$out" \
   && [[ -f "$TMP/queue/claimed/T-9107-demo.md" ]] \
   && [[ ! -f "$TMP/queue/review/T-9107-demo.md" ]]; then
  say "ok: review refuses when merging would leave two copies of the task file, and nothing moves"
else
  bad "the merge rehearsal did not refuse a duplicate main holds (rc=$rc): $out"
fi

# ---------------------------------------------------------------- 9. the rehearsal cannot answer -> refuse
# The other half of the rehearsal: `_would_duplicate_on_merge` returns None when git cannot read main, and
# cmd_review must REFUSE rather than treat "no answer" as "no duplicate". This is the behaviour the previous
# fixture accidentally depended on - it had no git at all, so cases 3 and 4 were failing on it - and nothing
# asserted it, so turning the refusal into a shrug would have gone unnoticed.
reset_repo
rm -rf "$TMP/.git"
make_task T-9108 ""
"$PY" "$Q" claim T-9108 --owner agent/alice >/dev/null 2>&1
out="$("$PY" "$Q" review T-9108 --reviewer agent/bob 2>&1)"; rc=$?
if [[ $rc -ne 0 ]] \
   && grep -q "cannot read main" <<<"$out" \
   && [[ -f "$TMP/queue/claimed/T-9108-demo.md" ]] \
   && [[ ! -f "$TMP/queue/review/T-9108-demo.md" ]]; then
  say "ok: review refuses when git cannot read main, instead of reading silence as 'no duplicate'"
else
  bad "review did not fail closed when main was unreadable (rc=$rc): $out"
fi

if [[ $fail -ne 0 ]]; then
  echo "LOCK LIFECYCLE FAIL"
  exit 1
fi
echo "LOCK LIFECYCLE OK"
