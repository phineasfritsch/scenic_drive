#!/usr/bin/env bash
# An exclusive lock is released when the work stops, and only by the task that holds it.
#
# The property, over the one tool that moves tasks:
#
#     claim T          =>  LOCKS/<res>.lock exists and names T
#     review T         =>  the lock is gone, T is in review/, and queue-check is clean
#     a hand `git mv`  =>  the lock survives and queue-check FAILS - which is why `review` exists
#     lock held by U   =>  review T releases nothing and moves nothing
#     reviewer == owner=>  refused
#
# Why this exists: there was no claimed -> review transition in code at all. Every agent did `git mv` plus a
# hand edit, so nothing ran at the moment the work stopped and the lock was never released. `cmd_check`
# already treats an orphaned lock as an error, so the first task to carry one into review/ would have failed
# `ops/queue-check` for every agent in every worktree. Exactly one lock exists today (scenic-index, held by
# T-0024, still claimed) and it had not happened yet.
#
# THE FIXTURE IS ONE TASK, AND THAT COLLIDED WITH THE POPULATION FLOOR (T-0091). T-0073 added MIN_TASKS = 40
# to cmd_check because `QUEUE OK (0 tasks)` was a real vacuous pass, and this fixture is a queue of one, so
# every `check` below started reporting "only 1 task(s) visible, floor is 40" and this whole file went red on
# every branch after T-0073. Neither guard was wrong: a lock LIFECYCLE test wants one task and a tree it can
# destroy, and the floor is what stops an emptied queue reading as a clean one.
#
# The resolution is NOT to lower the floor and NOT to inflate this fixture to forty tasks. Every `check` here
# now declares the population it built - `--expect-tasks 1` - which cmd_check enforces as an EQUALITY rather
# than a floor. On a tree this file constructs itself that is the stricter assertion of the two: it fails if
# the task vanishes AND if a second one appears, where the floor could only ever have caught the first, and
# only once it had lost thirty-nine. The floor still governs every argument-less run, which is every run
# P-PROC-01 and CI make.
#
# Cases 3b and 3c are there because a population assertion nobody has seen fail is not an assertion. They
# demonstrate, inside this file and on every invocation, that the declared count is checked (2 against a
# one-task tree FAILS) and that "I inspected nothing" cannot be declared correct (0 is REFUSED, exit 2).
#
# Anchored on the executable and on generated task fixtures, never on a comment.
set -uo pipefail
# Not `git rev-parse --show-toplevel`: from WSL against a Windows worktree it prints an unusable path and,
# without set -e, leaves the script running in whatever directory it started in (T-0055).
cd "$(dirname "${BASH_SOURCE[0]}")/../.." || { echo "cannot reach the repo root"; exit 2; }
[[ -f ops/lib/queue.py ]] || { echo "$(pwd) is not the repo root (no ops/lib/queue.py)"; exit 2; }

PY="${PYTHON:-$(command -v python3 || command -v python)}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
fail=0
Q="$TMP/ops/lib/queue.py"

reset_repo() {
  rm -rf "$TMP/queue" "$TMP/ops"
  mkdir -p "$TMP/ops/lib" "$TMP/queue"/{backlog,ready,claimed,review,blocked,done,LOCKS}
  cp ops/lib/queue.py "$Q"
}

# $1 = id, $2 = exclusive list body (e.g. "scenic-index"), $3 = state dir
make_task() {
  local id="$1" excl="$2" dir="${3:-ready}"
  { printf -- '---\nid: %s\ntitle: demo\nstate: %s\nowner: agent/alice\nowner_session: null\n' "$id" "$dir"
    printf -- 'claimed_at: null\nlease_expires_at: null\nworktree: null\nbranch: null\n'
    printf -- 'exclusive: [%s]\ntouches: [ops/]\npins_affected: []\nreviewer: null\ndepends_on: []\n' "$excl"
    printf -- 'verify: [ops/test]\nacceptance: []\n---\n## Brief\n\nA real sentence, so the brief guard passes.\n\n## Log\n'
  } > "$TMP/queue/$dir/$id-demo.md"
}

say() { printf '%s\n' "$1"; }
bad() { echo "FAIL: $1"; fail=1; }

# ---------------------------------------------------------------- 1. claim takes the lock
reset_repo
make_task T-9101 scenic-index
"$PY" "$Q" claim T-9101 --owner agent/alice >/dev/null 2>&1
if [[ -f "$TMP/queue/LOCKS/scenic-index.lock" ]] && grep -q "^T-9101 " "$TMP/queue/LOCKS/scenic-index.lock"; then
  say "ok: claim takes the lock and names the task"
else
  bad "claim did not take the lock"
fi

# ---------------------------------------------------------------- 2. the hand transition, which is the bug
# Reproduce exactly what every agent did before this command existed: move the file and edit the fields.
mv "$TMP/queue/claimed/T-9101-demo.md" "$TMP/queue/review/T-9101-demo.md"
sed -i 's/^state: claimed$/state: review/; s|^reviewer: null$|reviewer: agent/bob|' "$TMP/queue/review/T-9101-demo.md"
out="$("$PY" "$Q" check --expect-tasks 1 2>&1)"; rc=$?
# rc AND the message: a non-zero exit alone would be satisfied by any unrelated failure, and the message
# alone would be satisfied by a check that printed it and then exited 0.
if [[ $rc -eq 1 ]] && grep -q "scenic-index.lock held by T-9101" <<<"$out"; then
  say "ok: a hand git mv leaves the lock and queue-check FAILS - the red run this command exists for"
  say "    $(grep 'scenic-index.lock' <<<"$out" | head -1 | sed 's/^ *//')"
else
  bad "a hand transition did not produce the orphaned-lock failure (rc=$rc); premise not reproduced"
  printf '    %s\n' "$out" | head -3
fi

# ---------------------------------------------------------------- 3. the command releases it
reset_repo
make_task T-9102 scenic-index
"$PY" "$Q" claim T-9102 --owner agent/alice >/dev/null 2>&1
"$PY" "$Q" review T-9102 --reviewer agent/bob >/dev/null 2>&1
if [[ -f "$TMP/queue/LOCKS/scenic-index.lock" ]]; then
  bad "review did not release the lock"
elif [[ ! -f "$TMP/queue/review/T-9102-demo.md" ]]; then
  bad "review did not move the task"
else
  # The EXIT CODE, not `grep -q "^QUEUE OK"`. Matching the success wording is the same defect as matching
  # the failure wording, in the direction where a check that stops printing its banner reads as broken and a
  # check that prints it while exiting 1 reads as clean. cmd_check's verdict is its exit status.
  out="$("$PY" "$Q" check --expect-tasks 1 2>&1)"; rc=$?
  if [[ $rc -eq 0 ]]; then
    say "ok: review releases the lock, moves the task, and queue-check is clean ($out)"
  else
    bad "queue-check not clean after review (rc=$rc): $(head -2 <<<"$out")"
  fi
fi

# ------------------------------------------- 3b. the population assertion those runs lean on is not asleep
# Every `check` above declares --expect-tasks 1. If that argument were ignored, or if the equality were
# never evaluated, every case would still pass and this file would be asserting nothing about how much of
# the tree the check actually saw - which is the exact hole MIN_TASKS was added to close. So: the same tree,
# a wrong declared count, must FAIL. Same fixture, same command, one number different.
out="$("$PY" "$Q" check --expect-tasks 2 2>&1)"; rc=$?
if [[ $rc -eq 1 ]] && grep -q "1 task(s) visible, but this tree was declared to hold exactly 2" <<<"$out"; then
  say "ok: a wrong declared population FAILS on the same tree - the count is really being checked"
else
  bad "check --expect-tasks 2 on a one-task tree did not fail (rc=$rc): $(head -2 <<<"$out")"
fi

# ------------------------------------------- 3c. "it inspected nothing" cannot be declared correct
# The one sentence the floor exists to make unsayable stays unsayable under the declared form: a population
# of zero is REFUSED (exit 2), not merely failed, so no caller can opt out of the assertion by naming zero.
out="$("$PY" "$Q" check --expect-tasks 0 2>&1)"; rc=$?
if [[ $rc -eq 2 ]] && grep -q "inspected nothing" <<<"$out"; then
  say "ok: --expect-tasks 0 is refused outright, so the vacuous pass cannot be declared into legitimacy"
else
  bad "check --expect-tasks 0 was not refused (rc=$rc): $(head -2 <<<"$out")"
fi

# ---------------------------------------------------------------- 4. a task with no locks still transitions
reset_repo
make_task T-9103 ""
"$PY" "$Q" claim T-9103 --owner agent/alice >/dev/null 2>&1
if "$PY" "$Q" review T-9103 --reviewer agent/bob >/dev/null 2>&1 \
   && [[ -f "$TMP/queue/review/T-9103-demo.md" ]]; then
  say "ok: a task declaring no exclusive resources still moves"
else
  bad "review refused a task that holds no locks"
fi

# ---------------------------------------------------------------- 5. reviewer == owner is refused
reset_repo
make_task T-9104 ""
"$PY" "$Q" claim T-9104 --owner agent/alice >/dev/null 2>&1
out="$("$PY" "$Q" review T-9104 --reviewer agent/alice 2>&1)"; rc=$?
if [[ $rc -ne 0 ]] && grep -qi "may not grade its own work" <<<"$out" \
   && [[ -f "$TMP/queue/claimed/T-9104-demo.md" ]]; then
  say "ok: reviewer == owner refused, and the task did not move"
else
  bad "reviewer == owner was accepted (rc=$rc): $out"
fi

# ---------------------------------------------------------------- 6. a foreign lock is never taken over
reset_repo
make_task T-9105 scenic-index
"$PY" "$Q" claim T-9105 --owner agent/alice >/dev/null 2>&1
# Somebody else's lock, under a resource this task also declares.
printf 'T-9999 agent/carol 2026-01-01T00:00:00Z\n' > "$TMP/queue/LOCKS/scenic-index.lock"
out="$("$PY" "$Q" review T-9105 --reviewer agent/bob 2>&1)"; rc=$?
if [[ $rc -ne 0 ]] \
   && [[ -f "$TMP/queue/LOCKS/scenic-index.lock" ]] \
   && grep -q "^T-9999 " "$TMP/queue/LOCKS/scenic-index.lock" \
   && [[ -f "$TMP/queue/claimed/T-9105-demo.md" ]]; then
  say "ok: a lock held by another task is left alone and the transition refuses"
else
  bad "a foreign lock was released or the task moved anyway (rc=$rc): $out"
fi

# ---------------------------------------------------------------- 7. only ready tasks are claimable; only
#                                                                     claimed ones reviewable
reset_repo
make_task T-9106 "" done
out="$("$PY" "$Q" review T-9106 --reviewer agent/bob 2>&1)"; rc=$?
if [[ $rc -ne 0 ]] && grep -q "not claimed/" <<<"$out"; then
  say "ok: a task already in done/ cannot be handed to review"
else
  bad "review accepted a task that was not claimed (rc=$rc): $out"
fi

if [[ $fail -ne 0 ]]; then
  echo "LOCK LIFECYCLE FAIL"
  exit 1
fi
echo "LOCK LIFECYCLE OK"
