#!/usr/bin/env bash
# P-SRC-02's assertion. Same class of bug as P-OPS-01 (see ops/lib/check-exec-bits): the old one-liner was
#
#   test -z "$(find Sources Tests -name '*.swift' -exec awk 'NR>300{print FILENAME; exit}' {} \;)"
#
# Over a deleted, renamed or emptied Sources/Tests tree, `find` prints nothing, `test -z ""` is true, and the
# pin reports OK on an empty artefact. Three checks instead:
#
#   1. the tracked .swift file set is non-empty and plausibly complete
#   2. every Swift package in the tree contributes to that set, so no package is silently exempt
#   3. no tracked source file exceeds 300 lines - .swift, .py AND .ts
#
# `git ls-files` is used instead of `find` so untracked build junk is never counted and the check matches what
# is actually committed.
#
# CLAUDE.md states the cap with no language qualifier, and until now this only ever looked at Swift - while
# the Swift tree is a skeleton and every M2 task works in `services/etl/` and `services/api/`. The file
# closest to breaking the rule was in the language the rule was not checked in (agent/reviewer-33, reviewing
# T-0028, whose byways.py sits at 296). Checks 1 and 2 stay Swift-only on purpose: MIN_FILES and the package
# coverage guard are about the Swift PACKAGE layout, and there is no equivalent structure to assert for a
# directory of Python modules.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

MIN_FILES=5

# EVERY tracked .swift file, at any depth. The globs here were 'Sources/**/*.swift' and 'Tests/**/*.swift',
# which cover the root package and nothing else: a 301-line file under apps/ios/Packages/ScenicApp/Sources/
# passed the 300-line cap and did not even appear in the count. CLAUDE.md puts no package outside the cap.
mapfile -t files < <(git ls-files '*.swift')
n="${#files[@]}"

if [[ "$n" -lt "$MIN_FILES" ]]; then
  echo "P-SRC-02: only $n tracked .swift file(s) (expected >= $MIN_FILES)."
  echo "  An empty or truncated set must never read as 'no file exceeds 300 lines'."
  exit 1
fi

# Coverage guard. A manifest is itself a .swift file, so if a package's directory contributes NOTHING to the
# examined set, the set has been narrowed and a whole package has dropped out of the cap. That is exactly how
# the Apple package was exempt, and this is what makes narrowing it again loud instead of silent.
#
# BOTH manifest spellings. SwiftPM also accepts version-specific manifests named `Package@swift-<version>.swift`,
# and `*Package.swift` cannot match one - the name ends in `swift-6.0.swift`, not `Package.swift`
# (agent/reviewer-21, while reviewing T-0037). No file dodged the CAP because of that, since the cap runs over
# every tracked .swift file regardless; what was missed is narrower and is the whole job of this block. A
# package carrying ONLY a versioned manifest was never enumerated here, so if it later fell out of the checked
# set this guard would have stayed silent about it - the one thing it exists to be loud about.
#
# Packages are collected as DIRECTORIES and de-duplicated, because a package that ships both spellings is one
# package and would otherwise be reported twice.
missed=()
while IFS= read -r dir; do
  [[ -z "$dir" ]] && continue
  prefix=""; [[ "$dir" != "." ]] && prefix="$dir/"
  covered=0
  for f in "${files[@]}"; do
    [[ "$f" == "$prefix"* ]] && { covered=1; break; }
  done
  [[ $covered -eq 0 ]] && missed+=("$dir")
done < <(git ls-files '*Package.swift' '*Package@swift-*.swift' | while IFS= read -r m; do dirname "$m"; done | sort -u)

if [[ ${#missed[@]} -gt 0 ]]; then
  echo "P-SRC-02: Swift package(s) contribute no file to the checked set - the 300-line cap does not reach them:"
  printf '  %s\n' "${missed[@]}"
  exit 1
fi

# Everything the cap applies to. Vendored trees are excluded by `git ls-files` already, since nothing
# third-party is committed here; if that ever changes it is a deliberate decision, not this check's default.
mapfile -t capped < <(git ls-files '*.swift' '*.py' '*.ts' | grep -v '/node_modules/' || true)

# EXEMPTIONS. Each entry is a path and the task that removes it. Not a way to be under the cap - a way to
# turn the cap on TODAY for the ninety-odd files that comply, instead of leaving every Python file unchecked
# until one refactor lands. Two rules keep it from becoming permanent:
#   - an entry with no task id is refused, so nobody can add one without saying who will remove it;
#   - an entry whose file is now UNDER the cap is refused as stale, so a fixed file cannot keep its licence.
# Adding a name here is a visible diff on a load-bearing check. That is the intended cost.
declare -A EXEMPT=(
  ["ops/lib/queue.py"]="T-0059"   # 498 lines. Already 415 before T-0032 added the review transition, and
                                  # never reported because this check could not see Python. T-0059 splits it
                                  # along the seams its own section comments already mark.
  ["services/etl/tests/test_dockerfile.py"]="T-0062"
                                  # 436 lines on task/T-0046, 125 on task/T-0038 - it grew across T-0046's
                                  # four review rounds. Invisible on every branch INDIVIDUALLY: this file is
                                  # not on the chain this check lives on, and the chain it is on did not have
                                  # a Python cap. Found only by merging all 30 open branches into a throwaway
                                  # and running the gates after each. Without this entry the first merge of
                                  # the Dockerfile chain after T-0058 turns main red.
)

bad=(); stale=(); unowned=()
for f in "${capped[@]}"; do
  [[ -z "$f" ]] && continue
  # `wc -l` counts newlines, not lines: a file whose final line has no trailing newline is
  # undercounted by one, so a genuine 301-line file reads as 300 and slips past the cap.
  # `awk 'END{print NR}'` counts the last unterminated line too, matching what an editor or
  # compiler calls the line count.
  lines="$(awk 'END{print NR}' "$f" | tr -d '[:space:]')"
  owner="${EXEMPT[$f]:-}"
  if [[ "$lines" -gt 300 ]]; then
    if [[ -z "$owner" ]]; then
      bad+=("$f ($lines lines)")
    elif [[ ! "$owner" =~ ^T-[0-9]{4}$ ]]; then
      unowned+=("$f (exempt, but '$owner' is not a task id)")
    fi
  elif [[ -n "$owner" ]]; then
    stale+=("$f ($lines lines, exempt for $owner)")
  fi
done

if [[ ${#bad[@]} -gt 0 ]]; then
  echo "P-SRC-02: file(s) over the 300-line cap:"
  printf '  %s\n' "${bad[@]}"
  exit 1
fi
if [[ ${#unowned[@]} -gt 0 ]]; then
  echo "P-SRC-02: exemption(s) with no task to remove them:"
  printf '  %s\n' "${unowned[@]}"
  exit 1
fi
if [[ ${#stale[@]} -gt 0 ]]; then
  echo "P-SRC-02: exemption(s) no longer needed - the file is under the cap, so delete the entry:"
  printf '  %s\n' "${stale[@]}"
  exit 1
fi

echo "P-SRC-02: $n Swift files, ${#capped[@]} source files under the cap, ${#EXEMPT[@]} exempt"
