#!/usr/bin/env bash
# P-SAFE-03's mutation population: the table that proves ops/lib/check-safety-disclaimer red.
#
# One file, one concern. It lives beside the check rather than inside it because the check crossed 300 lines
# when the seventh mutation was added (CLAUDE.md's cap is written for Swift and Python and `check-line-cap`
# scans *.swift only, but a 330-line gate nobody can hold in their head is the thing the cap exists to stop).
#
# Each row mutates ONE structural fact in a throwaway copy of apps/ios, re-runs the check against that copy,
# and requires it to refuse AND to name the reason. A check nobody has seen refuse is a check nobody has
# tested (CLAUDE.md). A row that exits 0, or exits non-zero without naming its expected reason, fails the
# table and the table's exit status is 1.
#
# The copy is the whole of apps/ios, not just the feature sources, since PR #101's finding B2: the call
# graph is decided over every *.swift under the app tree, so a row has to be able to mutate the app shell
# (row 9) as well as the feature. The check is handed both halves explicitly - `--sources <copy>/<FS>` for
# the named files, `--app-tree <copy>` for the call graph.
#
# Reached through `bash ops/lib/check-safety-disclaimer --prove-red`, which first refuses to run a table
# against a tree that is already red. Running this file directly does the same work without that guard.
#
#   ROW = label | file under the apps/ios copy | sed script | substring the refusal must contain
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

CHECK="ops/lib/check-safety-disclaimer"
APP_TREE="apps/ios"
FS="Packages/ScenicApp/Sources/FeatureScenicHome"

[[ -f "$CHECK" ]] || { echo "P-SAFE-03: $CHECK is missing; the table has nothing to prove red."; exit 1; }
[[ -d "$APP_TREE/$FS" ]] || { echo "P-SAFE-03: $APP_TREE/$FS is missing; the table has nothing to mutate."; exit 1; }

rows=(
  "the SafetyDisclaimer type renamed|$FS/SafetyDisclaimer.swift|s/struct SafetyDisclaimer:/struct SafetyNotice:/|no SafetyDisclaimer declaration"
  "the home.disclaimer identifier removed|$FS/ScenicHomeScreen.swift|s/\"home.disclaimer\"/\"home.sheet\"/|home.disclaimer\" absent"
  "the acknowledgement guard removed|$FS/GatedHandoffButton.swift|s/guard isSafetyDisclaimerAcknowledged else {/do {/|no \`guard isSafetyDisclaimerAcknowledged else\`"
  "the persistent conditions line removed|$FS/ScenicHomeScreen.swift|s/Conditions change. Verify locally./Have a nice drive./|is not in"
  "the acknowledgement no longer passed to the button|$FS/ScenicHomeScreen.swift|s/isSafetyDisclaimerAcknowledged: isSafetyDisclaimerAcknowledged/isSafetyDisclaimerAcknowledged: true/|does not pass"
  "the on-device store key changed|$FS/ScenicHomeScreen.swift|s/safety.disclaimer.acknowledged.v1/whatever/|no @AppStorage"
  "the blocked tap no longer presents the disclaimer|$FS/ScenicHomeScreen.swift|s/onBlocked: { isShowingDisclaimer = true }/onBlocked: { }/|onBlocked"
  "the acknowledgement defaults to true|$FS/ScenicHomeScreen.swift|s/private var isSafetyDisclaimerAcknowledged = false/private var isSafetyDisclaimerAcknowledged = true/|does not default to false"
  "a second call site in the app shell|ScenicDrive/ScenicDriveApp.swift|s/ScenicHomeScreen()/ScenicHomeScreen().onAppear { try? SkylineHandoff.open() }/|must be called exactly once"
  "a second button beside the real one|$FS/ScenicHomeScreen.swift|s/^                    conditions$/                    conditions\n                    GatedHandoffButton(isSafetyDisclaimerAcknowledged: true, onBlocked: { }, onFailure: { _ in })/|constructed exactly once"
)

# Not `local` and not inside a function: the EXIT trap fires after a function's frame is gone, and a local
# here left the trap reading an unbound variable under `set -u` - printed after the table, temp tree kept.
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

pass=0
total=0
printf '%-52s %-8s %s\n' "MUTATION" "EXIT" "REASON NAMED"
for row in "${rows[@]}"; do
  total=$((total + 1))
  label="${row%%|*}"; rest="${row#*|}"
  file="${rest%%|*}"; rest="${rest#*|}"
  script="${rest%%|*}"
  expect="${rest##*|}"

  dir="$work/m$total"
  rm -rf "$dir"
  cp -R "$APP_TREE" "$dir"
  [[ -f "$dir/$file" ]] || { echo "  NO SUCH FILE in the copy: $file"; echo "$label"; exit 1; }
  sed -i -e "$script" "$dir/$file"

  out="$(bash "$CHECK" --sources "$dir/$FS" --app-tree "$dir" 2>&1)"
  status=$?

  named="no"
  if [[ "$out" == *"$expect"* ]]; then
    named="yes"
  fi
  printf '%-52s %-8s %s\n' "$label" "$status" "$named"
  if [[ "$status" -ne 0 && "$named" == "yes" ]]; then
    pass=$((pass + 1))
  else
    echo "  UNREFUSED or UNNAMED. Expected a non-zero exit naming: $expect"
    echo "$out" | sed -e 's/^/  | /'
  fi
done

echo "prove-red: $pass/$total mutations refused by name"
[[ "$pass" -eq "$total" ]] || exit 1
