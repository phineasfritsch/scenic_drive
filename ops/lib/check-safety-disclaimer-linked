#!/usr/bin/env bash
# P-SAFE-03 and P-ATTR-01, THE LINKED TREES (T-0289, rv3-t0273 recordable 1). Sourced by -pinned and called by
# require_pinned_app_swift as its LAST step, so every caller of the whole-app pin runs it; uses the caller's `fail`
# and -pinned's pinned_digest.
#
# rv3-t0273 added a PBXFileReference, a PBXBuildFile and a Sources-phase entry to project.pbxproj for
# ../../tools/xcode-shell/SurpriseCard.swift - a file OUTSIDE apps/ios declaring a module-local SurpriseCard whose
# button opens Apple Maps - so the frozen shell line builds that card, ungated, and check-safety-disclaimer exited 0:
# it read no pbxproj and no Swift outside apps/ios. Pinning the pbxproj alone would buy the next round one file at a
# time (the shell is an Xcode 26 BUILDABLE FOLDER, so a .m dropped into ScenicDrive/ compiles with no pbxproj edit; a
# scheme pre-action and ci_post_clone.sh run shell at build time; the root package the app links by path compiles
# Sources/). So everything the app build reads that -pinned does not already pin is pinned here, as WHITELISTS:
#   (1) THE ROOT MANIFEST'S PATHS. Every line of the root Package.swift carrying `path:` or `sources:` (trimmed,
#       //-leading lines dropped, nothing else parsed) is one of ROOT_PATH_LINES, compared WHOLE, each once.
#   (2) APPS/IOS BEYOND SWIFT. Every non-directory entry under the app tree NOT named *.swift (any case; those are
#       PINNED_APP_SWIFT's) is exactly one of PINNED_APP_OTHER, a REGULAR FILE, at its approved digest. The one
#       allowance is LINKED_TILES_RE: the owner's git-ignored la.pmtiles (+ .json) in the MAIN checkout's Tiles/.
#   (3) THE ROOT PACKAGE. The root Package.swift, and every non-directory entry under Sources/ (any extension, any
#       depth - ScenicKit, Handoff, PlaceStore, ScenicAPIClient, Telemetry and ScenicPlanCLI), exactly
#       PINNED_ROOT_SOURCES, each a REGULAR FILE at its approved digest.
#   (4) THE ROOT DIRECTORY'S OWN FILES. Every non-directory entry at the top of the root tree is NAMED in
#       ROOT_TOP_FILES (fm-t0289 M1: SwiftPM, and Xcode through it, builds Package@swift-6.swift over Package.swift
#       on a 6.x toolchain, so a sibling manifest moved Handoff to an unpinned Vendor/ past (1) and (3)).
#       Package.resolved is named: ops/test's Linux `swift test` writes it, and a package the app links by path
#       never resolves from its own - the app's is PINNED_APP_OTHER's.
# The root tree is DERIVED, APP_TREE/../.. (apps/ios -> the repository top): no flag or variable can point it at a
# copy on a real run; the mutation table lays its copies out as m<N>/apps/ios beside m<N>/Sources.
#
# FROM T-0289 ON, ANY EDIT TO A FILE UNDER Sources/, TO THE ROOT Package.swift OR TO ANY NON-SWIFT FILE UNDER apps/ios
# RE-APPROVES ITS ROW IN LINKED_DATA IN THE SAME COMMIT, with the reason in the task's Log - `sed -e 's/\r$//' FILE |
# sha256sum`. Since T-0303 the four tables are DATA there (the guard stays under the 300-line cap, a digest edit is a
# data edit); each row is bound to the tree both ways by the checks below, so a data-only edit is refused by name.
# Fail-closed by design: on a Mac whose Xcode wrote xcuserdata/ or .swiftpm/ under apps/ios this refuses (an
# xcuserdata scheme's pre-action runs shell). NOT SEEN: remote package code (MapLibre, GRDB - Package.resolved pins
# the revision, not the bytes), and what any of it does at run time.
LINKED_REASON="the pinned linked trees changed"
LINKED_TILES_RE='^ScenicDrive/Tiles/[^/]+\.pmtiles(\.json)?$'
LINKED_DATA="ops/lib/check-safety-disclaimer-linked-digests.txt"
LINKED_SECTIONS=(ROOT_PATH_LINES ROOT_TOP_FILES PINNED_APP_OTHER PINNED_ROOT_SOURCES)
LINKED_ROW_DIGEST='^[^[:space:]]+ [0-9a-f]{64}$'
LINKED_ROW_NAME='^[^[:space:]/]+$'
LINKED_ROW_LINE='^[^[:space:]](.*[^[:space:]])?$'
LINKED_ROW_PATHS='path:|sources:'

# linked_load: LINKED_DATA into the four tables, fail-closed (T-0303). Every line is a `[NAME]` header - NAME one of
# LINKED_SECTIONS, each once - or a row of the section above it in that section's shape: `PATH SHA256` for
# PINNED_APP_OTHER and PINNED_ROOT_SOURCES, one name for ROOT_TOP_FILES, a whole trimmed manifest line naming path: or
# sources: for ROOT_PATH_LINES. No key twice in a section, no section empty. A missing file, an unknown section, a
# duplicated path, a malformed row or an empty section each refuse by name; no line is skipped.
linked_load() {
  local line sec="" n=0 key s ok ref bad=()
  local -A seen=() keys=()
  ROOT_PATH_LINES=(); ROOT_TOP_FILES=(); PINNED_APP_OTHER=(); PINNED_ROOT_SOURCES=()
  [[ -f "$LINKED_DATA" ]] || fail "$LINKED_REASON: the approved tables file $LINKED_DATA is missing." \
    "The linked trees' approvals are data there (T-0303); no file is a refusal, never an empty approval."
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1)); line="${line%$'\r'}"
    if [[ "$line" == "["*"]" ]]; then
      sec="${line:1:${#line}-2}"; ok=0
      for s in "${LINKED_SECTIONS[@]}"; do [[ "$s" == "$sec" ]] && ok=1; done
      if [[ "$ok" -eq 0 ]]; then bad+=("unknown section [$sec] at line $n"); sec="?"
      elif [[ -n "${seen["$sec"]+x}" ]]; then bad+=("section [$sec] duplicated at line $n"); fi
      seen["$sec"]=1; continue
    fi
    case "$sec" in
      PINNED_APP_OTHER|PINNED_ROOT_SOURCES) key="${line%% *}"; [[ "$line" =~ $LINKED_ROW_DIGEST ]] ;;
      ROOT_TOP_FILES) key="$line"; [[ "$line" =~ $LINKED_ROW_NAME ]] ;;
      ROOT_PATH_LINES) key="$line"; [[ "$line" =~ $LINKED_ROW_LINE && "$line" =~ $LINKED_ROW_PATHS ]] ;;
      *) false ;;
    esac || { bad+=("malformed row in [${sec:-no section}] at line $n: $line"); continue; }
    [[ -z "${keys["$sec $key"]+x}" ]] || { bad+=("duplicated path in [$sec] at line $n: $key"); continue; }
    keys["$sec $key"]=1
    case "$sec" in
      ROOT_PATH_LINES) ROOT_PATH_LINES+=("$line") ;; ROOT_TOP_FILES) ROOT_TOP_FILES+=("$line") ;;
      PINNED_APP_OTHER) PINNED_APP_OTHER+=("$line") ;; *) PINNED_ROOT_SOURCES+=("$line") ;;
    esac
  done < "$LINKED_DATA"
  for s in "${LINKED_SECTIONS[@]}"; do ref="$s[@]"; set -- "${!ref}"; [[ "$#" -gt 0 ]] || bad+=("empty section [$s]"); done
  [[ "${#bad[@]}" -eq 0 ]] || fail "$LINKED_REASON: ${bad[0]}" "${bad[@]:1}" \
    "$LINKED_DATA holds the four approved tables (T-0303): a [NAME] header per table, each once, then its rows one" \
    "per line, each key once. A table that cannot be read whole is a refusal, never a partial approval."
}

# linked_set LABEL FOUND_FILE APPROVED_NAME...: appends `LABEL added ...` / `LABEL missing ...` to LINKED_BAD.
linked_set() {
  local label="$1" found="$2" added missing; shift 2
  added="$(LC_ALL=C comm -23 "$found" <(printf '%s\n' "$@" | LC_ALL=C sort) | sed -e '/^$/d' | tr '\n' ' ')"
  missing="$(LC_ALL=C comm -13 "$found" <(printf '%s\n' "$@" | LC_ALL=C sort) | sed -e '/^$/d' | tr '\n' ' ')"
  [[ -z "$added" ]] || LINKED_BAD+=("$label added ${added% }")
  [[ -z "$missing" ]] || LINKED_BAD+=("$label missing ${missing% }")
}

# linked_compare BASE SPEC...: appends `PATH content changed` to LINKED_BAD for each spec off its approved digest. ONE
# sha256sum over the raw bytes (a fork per file costs minutes on a loaded Windows box); a file whose raw digest is
# not the approved one is re-hashed through pinned_digest (CRLF normalized to LF) before it is refused, so a CRLF
# checkout of approved bytes passes and nothing else does.
linked_compare() {
  local base="$1" specs=("${@:2}") i
  pinned_raw "$base" "${specs[@]%% *}"
  for i in "${!specs[@]}"; do
    [[ "${PINNED_RAW["${specs[$i]%% *}"]-}" == "${specs[$i]##* }" ]] && continue
    [[ "$(pinned_digest "$base/${specs[$i]%% *}")" == "${specs[$i]##* }" ]] || LINKED_BAD+=("${specs[$i]%% *} content changed")
  done
}

# linked_unfinder DIR LIST: T-0295's ONE relief. Drops from the file LIST (names relative to DIR) each entry whose
# basename is exactly `.DS_Store` AND that `git -C DIR check-ignore` reports ignored (the repository's .gitignore, or the
# Mac's global excludes). The population stays every entry on disk, ignored ones included - an ignored xcuserdata scheme
# runs shell at build time and a self-ignoring .gitignore can hide a Sources/ file SwiftPM compiles - so an unignored,
# a tracked, or a differently named Finder file is refused by name as before, and so is every entry outside a work tree.
linked_unfinder() {
  local dir="$1" list="$2" all=() ds=() e
  mapfile -t all < "$list"
  for e in "${all[@]}"; do [[ "$e" == .DS_Store || "$e" == */.DS_Store ]] && ds+=("$e"); done
  [[ "${#ds[@]}" -gt 0 ]] || return 0
  local -A ign=()
  while IFS= read -r -d "" e; do ign["$e"]=1; done < <(printf '%s\0' "${ds[@]}" | git -C "$dir" check-ignore --stdin -z 2>/dev/null)
  for e in "${all[@]}"; do [[ -n "${ign["$e"]+x}" ]] || printf '%s\n' "$e"; done > "$list"
}

# require_pinned_linked APP_TREE: (1), then (2), (3) and (4)'s file sets, then every digest. Sets LINKED_FILES.
require_pinned_linked() {
  local tree="${1%/}" root spec line names=() lines=() approved=() nonreg=() tmp added
  linked_load
  root="$tree/../.."
  [[ -d "$tree" && -f "$root/Package.swift" && -d "$root/Sources" ]] || fail \
    "$LINKED_REASON: no root package (Package.swift and Sources/) at $root, two levels above $tree." \
    "The app links the root package by path; a tree without one is a refusal, never a pass."
  LINKED_BAD=()
  mapfile -t lines < <(sed -e 's/\r$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$root/Package.swift" \
    | grep -v '^//' | grep -E 'path:|sources:')
  approved=("${ROOT_PATH_LINES[@]}")
  for line in "${lines[@]}"; do
    local i hit=-1
    for i in "${!approved[@]}"; do [[ "${approved[$i]}" == "$line" ]] && { hit="$i"; break; }; done
    if [[ "$hit" -ge 0 ]]; then unset 'approved[hit]'; else LINKED_BAD+=("root manifest line not approved: $line"); fi
  done
  [[ "${#approved[@]}" -eq 0 ]] || LINKED_BAD+=("root manifest lines missing: ${approved[*]}")
  [[ "${#LINKED_BAD[@]}" -eq 0 ]] || fail "$LINKED_REASON: ${LINKED_BAD[0]}" "${LINKED_BAD[@]:1}" \
    "Every root Package.swift line naming a path: or sources: is typed in [ROOT_PATH_LINES] of" \
    "$LINKED_DATA: a target path moved off Sources/ compiles bytes no pin has read."
  tmp="$(mktemp)"
  (cd "$tree" && find . -mindepth 1 -path ./.git -prune -o ! -type d ! -iname '*.swift' -print | sed -e 's|^\./||' | grep -Ev "$LINKED_TILES_RE" \
    | LC_ALL=C sort) > "$tmp"
  linked_unfinder "$tree" "$tmp"
  names=(); for spec in "${PINNED_APP_OTHER[@]}"; do names+=("${spec%% *}"); done
  linked_set "apps/ios:" "$tmp" "${names[@]}"
  mapfile -t nonreg < <(cd "$tree" && find . -mindepth 1 -path ./.git -prune -o ! -type d ! -type f ! -iname '*.swift' -print | sed -e 's|^\./||')
  (cd "$root" && find Package.swift Sources ! -type d | LC_ALL=C sort) > "$tmp"
  linked_unfinder "$root" "$tmp"
  names=(); for spec in "${PINNED_ROOT_SOURCES[@]}"; do names+=("${spec%% *}"); done
  LINKED_FILES="${#names[@]}"
  linked_set "root:" "$tmp" "${names[@]}"
  (cd "$root" && find . -mindepth 1 -maxdepth 1 ! -type d | sed -e 's|^\./||' | LC_ALL=C sort) > "$tmp"
  linked_unfinder "$root" "$tmp"
  added="$(LC_ALL=C comm -23 "$tmp" <(printf '%s\n' "${ROOT_TOP_FILES[@]}" | LC_ALL=C sort) | tr '\n' ' ')"
  [[ -z "$added" ]] || LINKED_BAD+=("root top: added ${added% }")
  rm -f "$tmp"
  mapfile -t -O "${#nonreg[@]}" nonreg < <(cd "$root" && find Package.swift Sources ! -type d ! -type f)
  [[ "${#nonreg[@]}" -eq 0 ]] || LINKED_BAD+=("not a regular file ${nonreg[*]}")
  [[ "${#LINKED_BAD[@]}" -eq 0 ]] || fail "$LINKED_REASON: ${LINKED_BAD[*]}." \
    "Approved: ${#PINNED_APP_OTHER[@]} non-Swift file(s) under $tree, the root Package.swift and every entry under" \
    "Sources/, and the root's top-level file names in ROOT_TOP_FILES, typed in $LINKED_DATA" \
    "(rv3-t0273: a pbxproj entry compiled a SurpriseCard from outside apps/ios; fm-t0289 M1: a Package@swift-6.swift" \
    "beside Package.swift moved a target off Sources/). Approve an added, removed or renamed file there."
  linked_compare "$tree" "${PINNED_APP_OTHER[@]}"
  linked_compare "$root" "${PINNED_ROOT_SOURCES[@]}"
  [[ "${#LINKED_BAD[@]}" -eq 0 ]] || fail "$LINKED_REASON: ${LINKED_BAD[0]}" "${LINKED_BAD[@]:1}" \
    "Every byte the app build reads outside PINNED_APP_SWIFT - project.pbxproj, the scheme, ci_post_clone.sh, the" \
    "root Package.swift, Sources/ - is pinned (rv3-t0273). Approve an edit by typing its new digest in" \
    "$LINKED_DATA in the same commit, deliberately - \`sed -e 's/\r\$//' FILE | sha256sum\`."
}
