#!/usr/bin/env bash
# P-ATTR-01 limb (g): THE DRAWN LINE'S CREDIT, AS A WHITELIST OF WHOLE LINES. Sourced by
# ops/lib/check-map-attribution beside -lib, which is at CLAUDE.md's 300-line cap; this file has one role, this
# limb: the approved lines, the reader that enumerates the population, the refusal and the verdict line.
#
# Limb (d) reads both ENDS of the route credit - the footer's `routeData: <r>?.dataCredit` and the map's
# `route: <r>` - and never the VALUE <r> carries. rv2-t0236 (B1-r2) set that value to the demo credit inside
# MapRoute.bundled (M4a) and to the geometry resource's NAME inside DriveRoute.resolve (M4b), and every limb
# stayed green. The population here is every line that can hold code (trailing CR stripped) of every .swift file
# under the app tree that names `dataCredit`, `routeGeometryCredit` - the Handoff field DriveRoute binds the
# credit from - or the WORD `credit`, that binding, so a re-binding or a shadow of it in any file is counted
# too. Each is compared TRIMMED and WHOLE, with its file, against the lines typed below, in scan order (paths
# LC_ALL=C sorted, lines in file order). A new site, a missing one and a changed one are refused by name; a
# prefix or a substring match is never enough (the mutant pass's A2/A3 lesson, the same as limb (b)).
#
# Typed, not derived: raised deliberately, in the same commit as the Swift, the day the credit's path grows a
# line. `$0` below is Swift's closure argument, escaped so bash does not expand it.
CREDIT_SITES=(
  "Packages/ScenicApp/Sources/FeatureScenicHome/DriveMapLine.swift: return MapRoute(geoJSON: data, dataCredit: PlanPreview.attribution, lineColor: DesignTokens.route, casingColor: DesignTokens.surface)"
  "Packages/ScenicApp/Sources/FeatureScenicHome/DriveRoute.swift: guard let name = drive.routeGeometryResource, let credit = drive.routeGeometryCredit else {"
  "Packages/ScenicApp/Sources/FeatureScenicHome/DriveRoute.swift: dataCredit: credit,"
  "Packages/ScenicApp/Sources/FeatureScenicHome/DriveScreen.swift: AttributionFooter(text: CreditLine.composed(basemap: style.attributionText, routeData: route?.dataCredit))"
  "Packages/ScenicApp/Sources/FeatureScenicHome/PlanPreviewMap.swift: AttributionFooter(text: CreditLine.composed(basemap: style.attributionText, routeData: route?.dataCredit))"
  "Packages/ScenicApp/Sources/FeatureScenicHome/ScenicHomeScreen.swift: AttributionFooter(text: CreditLine.composed(basemap: style.attributionText, routeData: route?.dataCredit))"
  "Packages/ScenicApp/Sources/MapAdapter/MapRoute.swift: public let dataCredit: String"
  "Packages/ScenicApp/Sources/MapAdapter/MapRoute.swift: public init?(geoJSON: Data, dataCredit: String, lineColor: Color, casingColor: Color) {"
  "Packages/ScenicApp/Sources/MapAdapter/MapRoute.swift: box.allSatisfy({ \$0.isFinite }), !dataCredit.isEmpty else {"
  "Packages/ScenicApp/Sources/MapAdapter/MapRoute.swift: self.dataCredit = dataCredit"
  "Packages/ScenicApp/Sources/MapAdapter/MapRoute.swift: dataCredit: String,"
  "Packages/ScenicApp/Sources/MapAdapter/MapRoute.swift: return MapRoute(geoJSON: data, dataCredit: dataCredit, lineColor: lineColor, casingColor: casingColor)"
)

# The population, one "<line number>\t<path under the tree>: <trimmed line>" per line, in scan order. The key
# compared is what follows the tab, so a line moving inside its file is not a finding and a line changing is.
# FAIL-CLOSED (rv3-t0236 B1-r3): nothing is cut INSIDE a line. Round 3's reader toggled string state on every
# quote and cut the first `//` outside one, and a `"` in a /* */ comment, a raw string #"\"# and an interpolated
# "\("//")" each made it cut real code at a `//` inside a string. A line is dropped only when its trimmed text
# STARTS with `//` and holds no backslash - such a line holds no code (a backslash could open an interpolation
# inside a multi-line string literal, so it keeps the line). Every other line is compared WHOLE, trailing and
# block-comment text included, so a commented-out copy of an approved line is an extra, and is refused.
credit_site_lines() {
  awk -v root="$APP_TREE/" '
    {
      line = $0; sub(/\r$/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line)
      if (substr(line, 1, 2) == "//" && index(line, "\\") == 0) next
      if (index(line, "dataCredit") == 0 && index(line, "routeGeometryCredit") == 0 &&
          line !~ /(^|[^A-Za-z0-9_])credit([^A-Za-z0-9_]|$)/) next
      rel = FILENAME
      if (index(FILENAME, root) == 1) rel = substr(FILENAME, length(root) + 1)
      printf "%d\t%s: %s\n", FNR, rel, line
    }
  ' "$@"
}

# Sorted, one per line, and NOTHING for an empty list (a bare `printf '%s\n'` would hand comm one empty line).
sorted_lines() { [[ $# -gt 0 ]] && printf '%s\n' "$@" | LC_ALL=C sort; }

# (g). The population IS the approved list, in order, whole line for whole line. `fail` is the check's.
require_credit_sites() {
  [[ "${1:-}" == "--" ]] && shift
  local raw=() found=() r
  mapfile -t raw < <(credit_site_lines "$@")
  for r in "${raw[@]}"; do found+=("${r#*$'\t'}"); done
  CREDIT_SITES_FOUND="${#found[@]}"
  [[ "${#found[@]}" -gt 0 && "$(printf '%s\n' "${found[@]}")" == "$(printf '%s\n' "${CREDIT_SITES[@]}")" ]] && return 0
  local unapproved=() unmatched=()
  mapfile -t unapproved < <(LC_ALL=C comm -23 <(sorted_lines "${found[@]}") <(sorted_lines "${CREDIT_SITES[@]}"))
  mapfile -t unmatched < <(LC_ALL=C comm -13 <(sorted_lines "${found[@]}") <(sorted_lines "${CREDIT_SITES[@]}"))
  local shown=() u
  for u in "${unapproved[@]}"; do shown+=("  unapproved: $u"); done
  for u in "${unmatched[@]}"; do shown+=("  approved, not found: $u"); done
  [[ "${#shown[@]}" -gt 0 ]] || shown+=("  the same lines in a different order - the approved list is in scan order")
  fail "a credit site outside its approved whole lines: ${#found[@]} line(s) under $APP_TREE name the route's" \
    "data credit, ${#CREDIT_SITES[@]} approved; ${#unapproved[@]} unapproved, ${#unmatched[@]} approved line(s) not found." \
    "${shown[@]}" \
    "The population is every line naming dataCredit, routeGeometryCredit or the word credit, cut nowhere - only" \
    "a line STARTING with // is dropped, so a trailing or /* */ comment naming one is refused too - and" \
    "each is compared TRIMMED and WHOLE with its file. Limb (d) guards the credit's two ENDS - the footer reads" \
    "<route>?.dataCredit and the map draws <route> - so the VALUE between them is guarded here: the drive's" \
    "routeGeometryCredit, bound in DriveRoute.resolve and forwarded unchanged by MapRoute.bundled. rv2-t0236" \
    "set it to the demo credit in MapRoute.bundled (M4a) and to the resource name in DriveRoute (M4b), and" \
    "every other limb stayed green while the footer credited the wrong party for the line on the map."
}

print_credit_sites_verdict() {
  echo "P-ATTR-01 (g): every line under $APP_TREE naming dataCredit, routeGeometryCredit or the word credit"
  echo "  ($CREDIT_SITES_FOUND, read whole; only // lines dropped) is one of the ${#CREDIT_SITES[@]} approved whole lines, in order: the drive's"
  echo "  routeGeometryCredit bound in DriveRoute.resolve, forwarded unchanged by MapRoute.bundled, read by the footer."
  echo "  Not checked here: the VALUE of routeGeometryCredit (Sources/Handoff, the Linux tests own it)."
}

# T-0324 R5: THE DRIVE SURFACE, the second map surface. Limbs (d) and (e) read the home screen alone; a drive map
# with a footer composed from a SECOND resolve, a literal, a route it never draws, or hidden from VoiceOver, would
# pass them. So the same readers run over DriveScreen.swift: the footer is the ONE composed form, the map is mounted
# from the same style and route bindings, nothing there is accessibilityHidden(true), and its tiles come from ONE
# `DriveBasemap.planned(` call - a whitelist, so the home reaching for it too is refused by name.
MAP_SET="Packages/ScenicApp/Sources/FeatureScenicHome/DriveScreen.swift(1) Packages/ScenicApp/Sources/FeatureScenicHome/PlanPreviewMap.swift(1) Packages/ScenicApp/Sources/FeatureScenicHome/ScenicHomeScreen.swift(1)"
DRIVE_SCREEN_REL="Packages/ScenicApp/Sources/FeatureScenicHome/DriveScreen.swift"
# T-0405 R4: THE PLAN PREVIEW'S MAP, the third map surface - the same readers as the drive's, limb (f3).
PREVIEW_MAP_REL="Packages/ScenicApp/Sources/FeatureScenicHome/PlanPreviewMap.swift"
require_drive_surface() {
  [[ "${1:-}" == "--" ]] && shift
  require_tracked_occurrences "DriveBasemap.planned(" "planned resolve call" "$DRIVE_SCREEN_REL(1) $PREVIEW_MAP_REL(1)"     "ONE resolve per planned-route surface, held in state: a second is a second answer, and the credit then names"     "tiles the renderer never got (mutant pass A5, now on the drive map and the preview map)." -- "$@"
  require_planned_surface "f2" "the drive map" "$DRIVE_SCREEN_REL"
  require_planned_surface "f3" "the plan preview's map" "$PREVIEW_MAP_REL"
  require_preview_wiring -- "$@"
}
require_planned_surface() {
  local limb="$1" what="$2" rel="$3" home=("$FOOTER_ARG" "$FOOTER_STYLE" "$FOOTER_ROUTE") mounted styles all_h ok_h
  local surface="$APP_TREE/$rel"
  [[ -f "$surface" ]] || fail "missing file: $surface" "$what is typed into MAP_SET; a tree without it is a refusal."
  require_composed_footer "$surface"
  mounted="$(count_fixed_in "styleURL: $FOOTER_STYLE.url" "$surface")"
  styles="$(count_fixed_in "styleURL:" "$surface")"
  [[ "$mounted" -eq 1 && "$styles" -eq 1 ]] || fail     "$what is not mounted with the value its footer reads: \`styleURL: $FOOTER_STYLE.url\` occurs $mounted"     "time(s) in $surface and \`styleURL:\` $styles time(s), expected 1 and 1. The tiles and the credit are one fact."
  require_route_mount "$surface" "$FOOTER_ROUTE"
  read -r all_h ok_h <<<"$(hidden_counts "$surface")"
  [[ "$all_h" -eq "$ok_h" ]] || fail     "$surface hides something from accessibility: $all_h \`accessibilityHidden\` occurrence(s), $ok_h \`(false)\`."     "A WHITELIST, as at the home: this map's credit is read by VoiceOver like everybody else's."
  echo "P-ATTR-01 ($limb): $what $rel - footer $FOOTER_ARG, mounted from $FOOTER_STYLE and $FOOTER_ROUTE, one DriveBasemap.planned(, nothing hidden."
  FOOTER_ARG="${home[0]}" FOOTER_STYLE="${home[1]}" FOOTER_ROUTE="${home[2]}"
}

# T-0405 rv0 M-A, M-B (limb f4): THE PREVIEW'S MAP IS THE ONE DRAWN, AND IT IS DRAWN UNDER ITS CREDIT. (f3) reads
# the footer's argument and the mount, never what the plan sheet hands the card nor the ZStack's order: the
# `.preview` arm handing the card `AnyView(EmptyView())` (M-A, no map and no credit) and the footer moved before
# MapView (M-B, the map drawn over the credit) were both green on it with every digest re-approved. So PlanPreviewMap's
# struct and the `.preview` arm are frozen WHOLE (check-safety-disclaimer-frozen's readers: an added modifier, a
# moved line, a wrapper is refused), and every line under apps/ios naming previewMap or PlanPreviewMap - and every
# line of PlanPreviewCard.swift naming `map` - is an approved whole line, in scan order (a shadowing declaration,
# a second closure, a replaced argument or a re-bound card property is refused by name).
PLAN_SHEET_REL="Packages/ScenicApp/Sources/FeaturePlanSheet/PlanSheetScreen.swift"
FROZEN_PREVIEW_MAP=(
  'public struct PlanPreviewMap: View {'
  '@Environment(\.colorScheme) private var colorScheme'
  '@State private var style = MapStyle.maplibreDemoTiles'
  '@State private var route: MapRoute?'
  '@State private var creditBandTop: CGFloat = 0'
  ''
  'private let preview: PlanPreview'
  ''
  'public init(preview: PlanPreview) {'
  'self.preview = preview'
  '}'
  ''
  'public var body: some View {'
  'ZStack(alignment: .bottom) {'
  'MapView('
  'styleURL: style.url,'
  'centerLatitude: preview.route.first?.latitude ?? 0,'
  'centerLongitude: preview.route.first?.longitude ?? 0,'
  'zoomLevel: 11,'
  'coveredBelowY: creditBandTop,'
  'route: route'
  ')'
  'AttributionFooter(text: CreditLine.composed(basemap: style.attributionText, routeData: route?.dataCredit))'
  '.onGeometryChange(for: CGFloat.self) { $0.frame(in: .global).minY } action: { creditBandTop = $0 }'
  '}'
  '.clipped()'
  '.dynamicTypeSize(...HomeTypeSize.cap)'
  '.accessibilityIdentifier("plan.map")'
  '.task { resolveMap() }'
  '.onChange(of: colorScheme) { resolveMap() }'
  '.onChange(of: preview.route) { resolveMap() }'
  '}'
  ''
  'private func resolveMap() {'
  'route = DriveMapLine.route(for: preview.route)'
  'style = DriveBasemap.planned(appearance: colorScheme == .dark ? .dark : .light)'
  '}'
  '}'
)
# The arm, then the NEXT arm's first line: a case arm has no braces to count, so its end is the line that follows.
FROZEN_PREVIEW_ARM=(
  'case .preview(let ticket, let preview):'
  'PlanPreviewCard(preview: preview, map: previewMap(preview), destination: sheet.destination?.name ?? "",'
  'saveLine: saveLine,'
  'onSave: { save(preview, budgetMinutes: ticket.budgetMinutes) },'
  'onChangePlace: { searchFor(.destination) }, onDrive: { onDrive(preview) },'
  'onLoop: { showingLoop = true }, onTrip: { showingTrip = true })'
  'case .failed(_, let failure):'
)
PREVIEW_WIRING=(
  "Packages/ScenicApp/Sources/FeaturePlanSheet/PlanPreviewCard.swift: let map: AnyView"
  "Packages/ScenicApp/Sources/FeaturePlanSheet/PlanPreviewCard.swift: map"
  "Packages/ScenicApp/Sources/FeaturePlanSheet/PlanPreviewCard.swift: Button(\"Plan a road trip\", systemImage: \"map\", action: onTrip)"
  "Packages/ScenicApp/Sources/FeaturePlanSheet/PlanPreviewCard.swift: let distance = preview.distanceLabel.map { Text(\" \" + \$0).foregroundStyle(DesignTokens.fgMuted) }"
  "Packages/ScenicApp/Sources/FeaturePlanSheet/PlanPreviewCard.swift: return (distance.map { hero + \$0 } ?? hero).font(.title2)"
  "$PLAN_SHEET_REL: private let previewMap: @MainActor (PlanPreview) -> AnyView"
  "$PLAN_SHEET_REL: previewMap: @escaping @MainActor (PlanPreview) -> AnyView, onClose: @escaping () -> Void) {"
  "$PLAN_SHEET_REL: self.previewMap = previewMap"
  "$PLAN_SHEET_REL: PlanPreviewCard(preview: preview, map: previewMap(preview), destination: sheet.destination?.name ?? \"\","
  "$PREVIEW_MAP_REL: public struct PlanPreviewMap: View {"
  "ScenicDrive/ScenicDriveApp.swift: PlanSheetScreen(planner: LivePlanner.make(), tripPlanner: LiveTripPlanner.make(), dayLinks: TripDayLinks.urls, loopPlanner: LiveLoopPlanner.make(), loopLink: LoopLinks.url, surpriseGate: { LivePlanner.surpriseGate() }, onDrive: { isPlanning = false; drive = \$0 }, previewMap: { AnyView(PlanPreviewMap(preview: \$0)) }, onClose: { isPlanning = false })"
)
# Trimmed whole lines naming previewMap / PlanPreviewMap anywhere, or `map` in the card; only a line STARTING with //
# and holding no backslash is dropped (B1 rv1-t0295: a // line with a backslash can be code inside a string).
preview_wiring_lines() {
  awk -v root="$APP_TREE/" '
    {
      line = $0; sub(/\r$/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line)
      if (substr(line, 1, 2) == "//" && index(line, "\\") == 0) next
      if (line !~ /(^|[^A-Za-z0-9_])(previewMap|PlanPreviewMap)([^A-Za-z0-9_]|$)/ &&
          !(FILENAME ~ /FeaturePlanSheet\/PlanPreviewCard\.swift$/ && line ~ /(^|[^A-Za-z0-9_])map([^A-Za-z0-9_]|$)/)) next
      rel = FILENAME
      if (index(FILENAME, root) == 1) rel = substr(FILENAME, length(root) + 1)
      printf "%s: %s\n", rel, line
    }
  ' "$@"
}
# frozen_run FILE LABEL ARRAY: the approved lines, consecutive, from the ONE occurrence of the first.
frozen_run() {
  local file="$1" label="$2" kept=() i at=-1 n=0 j
  local -n run_want="$3"
  if [[ ! -f "$file" ]]; then FROZEN_BAD+=("$label: no such file $file"); return; fi
  mapfile -t kept < <(frozen_code_lines "$file")
  for i in "${!kept[@]}"; do [[ "${kept[$i]}" == "${run_want[0]}" ]] && { n=$((n + 1)); at="$i"; }; done
  if [[ "$n" -ne 1 ]]; then
    FROZEN_BAD+=("$label: the whole line \`${run_want[0]}\` occurs $n time(s) in $file, expected exactly 1"); return
  fi
  for j in "${!run_want[@]}"; do
    [[ "${kept[$((at + j))]-<end of file>}" == "${run_want[$j]}" ]] && continue
    FROZEN_BAD+=("$label line $((j + 1)) of ${#run_want[@]} in $file: approved \`${run_want[$j]}\`, found \`${kept[$((at + j))]-<end of file>}\`")
    return
  done
}
require_preview_wiring() {
  [[ "${1:-}" == "--" ]] && shift
  FROZEN_BAD=()
  frozen_block "$APP_TREE/$PREVIEW_MAP_REL" "PlanPreviewMap's struct (the map, then its credit over it)" \
    FROZEN_PREVIEW_MAP "import SwiftUI"
  frozen_run "$APP_TREE/$PLAN_SHEET_REL" "PlanSheetScreen's .preview arm" FROZEN_PREVIEW_ARM
  local found=() w
  mapfile -t found < <(preview_wiring_lines "$@")
  if [[ "$(printf '%s\n' "${found[@]}")" != "$(printf '%s\n' "${PREVIEW_WIRING[@]}")" ]]; then
    FROZEN_BAD+=("${#found[@]} line(s) name previewMap / PlanPreviewMap (or \`map\` in PlanPreviewCard.swift), ${#PREVIEW_WIRING[@]} approved; found, in scan order:")
    for w in "${found[@]}"; do FROZEN_BAD+=("  $w"); done
  fi
  [[ "${#FROZEN_BAD[@]}" -eq 0 ]] || fail "the plan preview's map is not wired and drawn as approved (f4):" \
    "${FROZEN_BAD[@]}" \
    "The preview's ONLY credit is PlanPreviewMap's footer: the shell builds it, PlanSheetScreen's .preview arm hands" \
    "it to the card as \`map\`, and the footer is drawn AFTER MapView in its ZStack, so over it. rv0-t0405 M-A handed" \
    "the card an empty view and M-B drew the map over the credit; every other limb was green on both. Each block" \
    "is a whole-line whitelist - an edit is refused until this list is edited in the same commit."
  echo "P-ATTR-01 (f4): PlanPreviewMap's struct and the .preview arm frozen whole; ${#found[@]} approved line(s) wire previewMap."
}
