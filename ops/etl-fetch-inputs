#!/usr/bin/env bash
# Fetch and verify every external input the ETL consumes. See services/etl/inputs/manifest.yaml.
#
# The payloads go to ONE directory shared by every worktree - $SCENIC_ETL_INPUTS, else the MAIN checkout's
# services/etl/inputs/ - because etl.fetch resolves it (fetch.resolve_inputs_dir; queue/README.md). This
# wrapper deliberately does not compute that path itself: one implementation of the rule, in the language
# that has tests for it. `--verify-only` prints the directory it used as its first line.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)/services/etl"
exec "${PYTHON:-$(command -v python3 || command -v python)}" -m etl.fetch "$@"
