#!/usr/bin/env bash
# Rejects commits that would corrupt the repo for the agent fleet.
#  1. CRLF in any staged text file.
#  2. Secret-looking content or files (sk. tokens, private keys, .p8/.p12/.netrc/.env).
#  3. Staged paths outside the current task's `touches:` list (active once a queue task file exists for the
#     branch, in claimed/, review/ OR done/ - a signed-off task still commits nothing that wasn't already
#     allowed; review does not widen what a path may touch). The list is read from the task file AS STAGED,
#     never from the working tree (T-0160).
#  4. Staged content that is stale relative to the working tree: `git mv` stages a rename against the
#     PRE-edit blob and the edit that follows is never re-staged, so the commit records something other
#     than what the author is looking at (T-0047, re-landed on this hook by T-0160).
# Floor-lowering protection lives in .githooks/commit-msg (T-0002).
set -uo pipefail
fail=0
CR=$(printf '\r')

# NUL-DELIMITED, WHEREVER THE STAGED LIST IS READ (T-0160). Plain `--name-only` C-QUOTES any path holding a
# non-ASCII byte - `allowed/café-note.txt` arrives as the 27-character literal `"allowed/caf\303\251-note.txt"`,
# quotes and backslashes included - and that string is not a path. `git show ":$f"` fails on it, so the
# fail-closed branch below (T-0140) refuses an ordinary commit, and the `touches:` loop then reports the
# same unreadable spelling as outside the list. Both were measured on the shipped hook. `-z` turns the
# quoting off; `tr` puts the list back on lines, which is the shape everything downstream reads.
#
# A path containing a literal newline would still split wrong here. git can store one; nothing in this
# repository creates one, and the alternative (arrays everywhere) breaks under `set -u` on the bash 3.2
# that ships with macOS, which is a platform this hook runs on.
staged="$(git diff --cached --name-only -z --diff-filter=ACMR | tr '\0' '\n')"
[[ -z "$staged" ]] && exit 0

# 1 and 2. CRLF and secrets, read from the STAGED blob, never from the working file.
#
# NOT `git show ":$f" | grep -q PAT` (T-0140). `grep -q` exits at its first match; if `git show` is still
# writing it gets SIGPIPE and exits 141, and under the `pipefail` on line 13 the pipeline's status is 141,
# so the `if` reads "no match". Measured with the real hook: a 256 KB file with an sk. token on line 1
# COMMITTED, exit 0, nothing printed - 1 KB and 64 KB were refused, 256 KB, 1 MB and 4 MB were not. The
# secret scan CLAUDE.md promises was a race that any file over the pipe buffer won.
#
# So each blob is read ONCE into a temp file, with `git show`'s own exit status checked - a blob that
# cannot be read fails CLOSED, because "could not look" must never read as "nothing there" - and grep runs
# on the file, where its early exit costs nothing and nobody is left holding a broken pipe.
blob="$(mktemp)"
trap 'rm -f "$blob"' EXIT
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  # A submodule entry (mode 160000) is a commit id, not content: `git show ":$f"` exits 128 on it, and
  # the fail-closed branch below would refuse every commit that stages one. No .gitmodules exists in this
  # repository today; if one arrives, its gitlinks are skipped here on purpose and its files are scanned in
  # their own repository's hook. Read from the index, not the working tree, so a directory that merely
  # looks like a submodule cannot dodge the scan.
  if [[ "$(git ls-files -s -- "$f" | cut -d" " -f1)" == "160000" ]]; then continue; fi
  if ! git show ":$f" > "$blob" 2>/dev/null; then
    echo "pre-commit: cannot read the staged blob for $f, so it cannot be scanned; refusing rather than assuming"
    fail=1
    continue
  fi
  if grep -qI "$CR" "$blob"; then echo "pre-commit: CRLF in $f (repo is LF-only, see .gitattributes)"; fail=1; fi
  case "$f" in
    *.p8|*.p12|*.netrc|.netrc|.env|.env.*) echo "pre-commit: secret file staged: $f"; fail=1;;
  esac
  if grep -qE '(sk\.[A-Za-z0-9_-]{20,}|BEGIN (RSA |EC )?PRIVATE KEY|AKIA[0-9A-Z]{16})' "$blob"; then
    echo "pre-commit: secret-looking content in $f"; fail=1
  fi
done <<< "$staged"

# 3. touches: enforcement
#
# ON A MERGE, THE STAGED LIST IS NOT THE AUTHOR'S CHANGES. `git merge` stages every file the other side
# brings in, so a task branch merging `main` stages dozens of paths its author never opened. Checking those
# against `touches:` refuses the commit - measured on task/T-0097, which needed `main` to resolve one real
# conflict in ops/merge (a path that IS in its touches:) and was refused with 41 paths, every one a file
# main had changed and the branch had not.
#
# That is very likely the cause of the branch tower T-0113 measured: if merging main into a task branch is
# blocked, the only way to get current with main is to branch off another task branch, which is exactly the
# shape it found and could not explain. It also pushes a careful author toward `--no-verify` at the one
# moment care matters most - resolving a conflict - which turns off the secret scan and the CRLF check too.
#
# The fix is NOT to skip the check when MERGE_HEAD exists. A merge commit legitimately carries the author's
# own conflict resolutions, and those are precisely what `touches:` should still govern; skipping would make
# "merge main" a way to smuggle any file into any branch.
#
# So: on a merge, check the paths that differ from BOTH parents. A file identical to either side arrived
# from that side and is not an edit; a file differing from both is a resolution the author wrote.
#
# THAT SENTENCE IS TRUE ONLY IN THE MERGE_HEAD DIRECTION, and a reviewer was right to say so. Taking OURS -
# `git merge -X ours`, or resolving by keeping this branch's version - produces a file identical to HEAD
# while silently discarding main's change to it. No rule over staged paths can see that, because nothing was
# staged. It is a real limit of this gate and it is stated here rather than implied away.
#
# THIS NARROWING IS FOR `touches:` ONLY. Check 4 below reads the FULL staged list on a merge, for the same
# reason the secret scan does: its question is whether the staged bytes are the bytes on disk, which is
# not a question about who owns the path. A merged-in file's index and working-tree copies are both the
# merge result, so it compares equal and nothing legitimate is refused - while a file the author edits
# AFTER `git merge --no-commit` has staged content identical to MERGE_HEAD, drops out of the intersection
# below, and would be invisible to a narrowed check 4 (ops/lib/check-stale-stage.py, case 10).
to_check="$staged"
if [[ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]]; then
  # `git rev-parse --git-dir`, not `--show-toplevel`: the latter is banned under ops/ and in the hooks
  # because from WSL this checkout's `.git` file reads `gitdir: C:/...` which WSL's git cannot follow.
  #
  # `--no-renames` IS LOAD-BEARING, not tidiness. With rename detection on - which is the default - a diff
  # prints only a rename's DESTINATION, so the source path disappears from that side's diff and drops out
  # of the intersection - from EITHER side: the MERGE_HEAD side when the moved file was changed by main
  # (case 5), the HEAD side when it was not (case 11, T-0139). A reviewer used the first to defeat this
  # gate outright:
  #
  #     git merge --no-commit --no-ff main
  #     git mv ops/merge allowed/merge      # `touches: [allowed/]`
  #     git commit                          # exit 0
  #
  # A task branch could relocate ANY file in the repository into its own touches: prefix inside a merge
  # commit and then own it. The intersection was omitting a path that genuinely differs from both parents,
  # which is precisely the rule the comment above claims to implement.
  #
  # `git rev-parse MERGE_HEAD` also resolves a multi-sha octopus MERGE_HEAD to its FIRST parent only, so
  # files arriving from parents 2..n look like author edits. That fails CLOSED - an octopus merge is
  # refused - and is left that way deliberately; octopus merges are not part of this workflow.
  #
  # A GATE THAT CANNOT COMPUTE THE NARROWER SET CHECKS THE WIDER ONE (T-0137). Both diffs are run into
  # variables and their exit codes read, because process substitution throws the status away: an intersection
  # is empty as soon as EITHER side is, so one failing call is enough to leave the loop below with nothing
  # to iterate over and the gate checking NOTHING - silently, no warning, and the commit that results looks
  # ordinary afterwards. An empty `.git/MERGE_HEAD` was enough to produce it. Found by agent/rv-keystone
  # while passing PR #78, the commit that introduced this whole branch; case 8 of
  # ops/lib/check-touches-merge.py is the reproduction.
  #
  # `||`, NOT `&&`, and that is measured rather than reasoned (T-0139). Every earlier version of this
  # comment - and the task, the Log and the PR body - said "when BOTH calls fail". They are wrong: in the
  # case-8 scenario an instrumented copy of this hook prints `head_rc=0 merge_rc=128`. The diff against HEAD
  # SUCCEEDS; only MERGE_HEAD is unresolvable. A hook implementing the sentence those comments wrote would
  # be `&&`, would never fire here, and turns case 8 red. "The command errored" must never read as "there is
  # nothing to check", and it takes only one command to error.
  #
  # `-z | tr` on both sides for the same reason as the staged list above: without it a non-ASCII path
  # arrives C-quoted from one diff and raw from the other, so it never intersects with itself.
  head_paths="$(git diff --cached --name-only -z --no-renames HEAD | tr '\0' '\n' | sort)"; head_rc=$?
  merge_paths="$(git diff --cached --name-only -z --no-renames MERGE_HEAD | tr '\0' '\n' | sort)"; merge_rc=$?
  if [[ $head_rc -ne 0 || $merge_rc -ne 0 ]]; then
    echo "pre-commit: merge in progress, but the diff against HEAD/MERGE_HEAD failed" \
         "(exit $head_rc/$merge_rc); checking touches: against the FULL staged set instead"
    to_check="$staged"
  else
    to_check="$(comm -12 <(printf '%s\n' "$head_paths") <(printf '%s\n' "$merge_paths"))"
  fi
  if [[ -n "$to_check" && $head_rc -eq 0 && $merge_rc -eq 0 ]]; then
    echo "pre-commit: merge in progress; checking touches: against the $(printf '%s\n' "$to_check" | grep -c .) path(s) that differ from both parents"
  fi
fi

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [[ "$branch" =~ ^task/(T-[0-9]+) ]]; then
  task="${BASH_REMATCH[1]}"
  taskfile="$(ls queue/claimed/"$task"*.md queue/review/"$task"*.md queue/done/"$task"*.md 2>/dev/null | head -1 || true)"
  if [[ -n "$taskfile" ]]; then
    # THE GATE READS THE TASK FILE THAT IS BEING COMMITTED, NOT THE ONE ON DISK (T-0160). Reading the
    # working-tree file let an author widen `touches:` in their editor, leave that edit unstaged, and land a
    # path the committed task file forbids: `git show HEAD:<task file>` afterwards still says the path was
    # out of scope, and the widening exists nowhere in the history. A reviewer landed it as ATTACK 3 on the
    # shipped hook. The index is the right source because the index is what the commit will contain.
    #
    # HEAD is the fallback for the one case the index cannot answer: the task file removed from the index
    # (`git rm --cached`) or left unmerged, where `git show ":$taskfile"` exits non-zero. A task file that
    # is in NEITHER is a gate that cannot read its own rule, and that refuses rather than waving the commit
    # through - the same posture as the unreadable-blob branch in check 1/2.
    taskyaml="$(git show ":$taskfile" 2>/dev/null || true)"
    [[ -z "$taskyaml" ]] && taskyaml="$(git show "HEAD:$taskfile" 2>/dev/null || true)"
    if [[ -z "$taskyaml" ]]; then
      echo "pre-commit: $taskfile is in the working tree but in neither the index nor HEAD, so this hook" \
           "cannot read the touches: that is being committed. Fix: git add -- \"$taskfile\""
      fail=1
    fi
    # touches: [a, b, c]  (single line, YAML flow list)
    allowed="$(grep -E '^touches:' <<< "$taskyaml" | head -1 | sed -E 's/^touches:[[:space:]]*\[(.*)\][[:space:]]*$/\1/' | tr ',' '\n' | sed -E 's/^[[:space:]]*["'"'"']?//; s/["'"'"']?[[:space:]]*$//' | grep -v '^$')"
    if [[ -n "$allowed" ]]; then
      while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        ok=0
        [[ "$f" == queue/* ]] && ok=1   # a task may always update its own queue file
        while IFS= read -r a; do [[ -z "$a" ]] && continue; [[ "$f" == "$a"* ]] && ok=1; done <<< "$allowed"
        if [[ $ok -eq 0 ]]; then echo "pre-commit: $f is outside $task touches: [$(echo "$allowed" | tr '\n' ' ')]"; fail=1; fi
      done <<< "$to_check"
    fi
  fi
fi

# 4. STAGED CONTENT vs. THE WORKING TREE (T-0047; its fix never reached main, re-landed by T-0160).
#
# Six agents in one session shipped a commit whose staged content was a snapshot from before their edit:
# `git mv` stages the rename against the PRE-edit blob, the file is then rewritten, and the edit is never
# re-staged. `git status` shows a clean rename and says nothing is wrong; the commit lands as a pure rename
# with 0 insertions, silently dropping a reviewer's verdict and their entire findings log.
#
# Object ids, not raw bytes: `git hash-object -- "$f"` applies the same clean filters (.gitattributes
# `text=auto eol=lf`) that `git add` applies, so a file that is CRLF on disk and LF in the index hashes
# EQUAL here and is correctly left alone. A byte compare would refuse every text file on this Windows
# checkout.
#
# Symlinks are compared by TARGET TEXT, not through the link. `git hash-object -- "$f"` dereferences a
# symlink and hashes the target FILE's content, while `git add` stores the link's own target text (mode
# 120000): comparing those refuses every staged symlink unconditionally, even one untouched since `git add`.
# reviewer-28 measured that on WSL2/ext4 against T-0047's first version. `-L` is lstat-based, so a broken
# link still tests true, and branching on the working-tree entry's CURRENT type means a type change in
# either direction is still compared against what is on disk.
#   LOW, disclosed and not fixed (reviewer-28, T-0047): a symlink whose stored target text itself ends in a
#   newline is a false positive, because `$(readlink -- "$f")` strips ALL trailing newlines, not just the
#   one readlink adds for display. `ln -s $'foo\n' link` is the only way to produce it. Windows cannot
#   create a real symlink without privilege (`ln -s` silently copies instead), so the whole symlink branch
#   is verified on WSL2/Linux only - ops/lib/check-stale-stage.py does not exercise it.
#
# A staged deletion never reaches this loop (--diff-filter=ACMR excludes D), so `git rm` is out of scope by
# construction. A path staged and then deleted from disk is a different thing - staged content that no
# longer exists to be reviewed - and is reported separately below.
#
# ALLOW_PARTIAL_STAGE=1, and only the value 1, waives the refusal for a deliberate `git add -p`. Any other
# value is not the waiver: an escape hatch nobody can spell by accident is the point, and a variable left
# exported in a shell from an earlier commit must not quietly wave through an unrelated stale file. The
# waiver is announced on stderr, because a commit that recorded content the author was not looking at
# should say so at the moment it happens.
stale=""
missing=""
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  if [[ "$(git ls-files -s -- "$f" | cut -d" " -f1)" == "160000" ]]; then continue; fi
  staged_oid="$(git rev-parse ":$f" 2>/dev/null || true)"
  [[ -z "$staged_oid" ]] && continue
  if [[ ! -e "$f" && ! -L "$f" ]]; then missing="$missing$f"$'\n'; continue; fi
  if [[ -L "$f" ]]; then
    working_oid="$(printf '%s' "$(readlink -- "$f")" | git hash-object --stdin 2>/dev/null || true)"
  else
    working_oid="$(git hash-object -- "$f" 2>/dev/null || true)"
  fi
  # An empty working_oid means hash-object could not read the file; that is not "they match".
  [[ "$working_oid" != "$staged_oid" ]] && stale="$stale$f"$'\n'
done <<< "$staged"

if [[ -n "$stale" || -n "$missing" ]]; then
  allow="${ALLOW_PARTIAL_STAGE:-}"
  if [[ "$allow" == "1" ]]; then
    echo "pre-commit: ALLOW_PARTIAL_STAGE=1 waives the stale-content check for: $(echo "$stale$missing" | tr '\n' ' ')" >&2
  else
    if [[ -n "$allow" ]]; then
      echo "pre-commit: ALLOW_PARTIAL_STAGE is set to '$allow', which is not the value 1 - the only value" \
           "that waives the stale-content check" >&2
    fi
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      echo "pre-commit: staged content in $f is stale - the working tree changed after 'git add', so this" \
           "commit would record something other than what you are looking at. Fix: git add -- \"$f\"." \
           "For a deliberate partial stage, set ALLOW_PARTIAL_STAGE=1."
      fail=1
    done <<< "$stale"
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      echo "pre-commit: $f is staged but missing from the working tree (deleted after 'git add')." \
           "Fix: git add -- \"$f\" to stage the deletion, or restore the file." \
           "For a deliberate partial stage, set ALLOW_PARTIAL_STAGE=1."
      fail=1
    done <<< "$missing"
  fi
fi

if [[ $fail -ne 0 ]]; then echo "pre-commit: refusing commit"; exit 1; fi
